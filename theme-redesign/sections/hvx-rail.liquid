{%- assign c = section.settings.collection -%}
{%- if c != blank -%}
<section class="hvx hvx-sec{% if section.settings.mist %} hvx-sec--mist{% endif %}">
  <div class="hvx-wrap">
    <div class="hvx-head">
      <div>{%- if section.settings.eyebrow != blank -%}<p class="hvx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="hvx-h2">{{ section.settings.heading | default: c.title }}</h2>{%- if section.settings.text != blank -%}<p class="hvx-lead">{{ section.settings.text }}</p>{%- endif -%}</div>
      <a class="hvx-link" href="{{ c.url }}">{{ section.settings.link_text | default: 'View all' }}</a>
    </div>
    <div class="hvx-rail" role="list">
      {%- for p in c.products limit: section.settings.limit -%}
        <div role="listitem">{%- render 'hvx-card', product: p, eager: false -%}</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Havoc product row","tag":"div","class":"hvx-s-rail",
"settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"link_text","label":"Link text","default":"View all"},{"type":"range","id":"limit","label":"Products","min":4,"max":16,"step":1,"default":10},{"type":"checkbox","id":"mist","label":"Grey background","default":false}],
"presets":[{"name":"Havoc product row"}]}
{% endschema %}
