{%- comment -%} Products whose main photo is under 700px wide are skipped so blurry images never show. {%- endcomment -%}
{%- liquid
  assign c = section.settings.collection
  assign list = section.settings.products
  assign link = section.settings.link | default: c.url
-%}
{%- if list != blank or c != blank -%}
<section class="hvx hvx-sec{% if section.settings.mist %} hvx-sec--mist{% endif %}">
  <div class="hvx-wrap">
    <div class="hvx-head">
      <div>{%- if section.settings.eyebrow != blank -%}<p class="hvx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="hvx-h2">{{ section.settings.heading | default: c.title }}</h2>{%- if section.settings.text != blank -%}<p class="hvx-lead">{{ section.settings.text }}</p>{%- endif -%}</div>
      {%- if link != blank -%}<a class="hvx-link" href="{{ link }}">{{ section.settings.link_text | default: 'View all' }}</a>{%- endif -%}
    </div>
    <div class="hvx-rail" role="list">
      {%- if list != blank -%}
        {%- assign hvx_shown = 0 -%}{%- for p in list limit: 40 -%}{%- if hvx_shown >= section.settings.limit -%}{%- break -%}{%- endif -%}{%- assign hvx_fw = p.featured_media.preview_image.width | default: 0 -%}{%- if hvx_fw < 700 -%}{%- continue -%}{%- endif -%}<div role="listitem">{%- render 'hvx-card', product: p, prefix: section.id, badge: section.settings.badge -%}</div>{%- assign hvx_shown = hvx_shown | plus: 1 -%}{%- endfor -%}
      {%- else -%}
        {%- assign hvx_shown = 0 -%}{%- for p in c.products limit: 40 -%}{%- if hvx_shown >= section.settings.limit -%}{%- break -%}{%- endif -%}{%- assign hvx_fw = p.featured_media.preview_image.width | default: 0 -%}{%- if hvx_fw < 700 -%}{%- continue -%}{%- endif -%}<div role="listitem">{%- render 'hvx-card', product: p, prefix: section.id, badge: section.settings.badge -%}</div>{%- assign hvx_shown = hvx_shown | plus: 1 -%}{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Havoc product row","tag":"div","class":"hvx-s-rail",
"settings":[{"type":"product_list","id":"products","label":"Hand-picked products (overrides collection)","limit":16},{"type":"collection","id":"collection","label":"Or collection"},{"type":"url","id":"link","label":"View-all link"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"link_text","label":"Link text","default":"View all"},{"type":"text","id":"badge","label":"Badge on every card (e.g. Best seller)"},{"type":"range","id":"limit","label":"Products","min":4,"max":16,"step":1,"default":10},{"type":"checkbox","id":"mist","label":"Grey background","default":false}],
"presets":[{"name":"Havoc product row"}]}
{% endschema %}
