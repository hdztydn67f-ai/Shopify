<section class="hvx hvx-sec hvx-sec--mist">
  <div class="hvx-wrap">
    <div class="hvx-head hvx-reveal">
      <div>{%- if section.settings.eyebrow != blank -%}<p class="hvx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="hvx-h2">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p class="hvx-lead">{{ section.settings.text }}</p>{%- endif -%}</div>
    </div>
    <div class="hvx-brands">
      {%- for b in section.blocks -%}
        {%- assign c = b.settings.collection -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        {%- assign im = b.settings.image | default: b.settings.product.featured_image | default: c.products.first.featured_image | default: c.image -%}
        <a class="hvx-brand hvx-reveal" href="{{ c.url }}" {{ b.shopify_attributes }}>
          <span class="hvx-brand__img">{%- if im -%}{{ im | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width:750px) 33vw, 42vw', alt: b.settings.title | default: c.title | append: ' boxing gloves' }}{%- endif -%}</span>
          <span class="hvx-brand__txt">
            <span class="hvx-brand__name">{{ b.settings.title | default: c.title }}</span>
            <span class="hvx-brand__meta">{{ b.settings.text }}</span>
            <span class="hvx-brand__cta">Shop {{ b.settings.title | default: c.title }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Havoc shop by brand","tag":"div","class":"hvx-s-brands",
"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by brand"},{"type":"text","id":"heading","label":"Heading","default":"The brands fighters trust"},{"type":"textarea","id":"text","label":"Text"}],
"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"product","id":"product","label":"Product photo to show (white background works best)"},{"type":"text","id":"title","label":"Brand name"},{"type":"text","id":"text","label":"Short line"},{"type":"image_picker","id":"image","label":"Image override (optional)"}]}],
"presets":[{"name":"Havoc shop by brand"}]}
{% endschema %}
