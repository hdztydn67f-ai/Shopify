{%- comment -%}
  Sale countdown bar. Counts to a real end date set in the editor, then hides itself.
  It does not restart on its own: change the dates when you run a new sale.
{%- endcomment -%}
{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
  assign start_s = section.settings.start | date: '%s' | plus: 0
  assign end_s = section.settings.end | date: '%s' | plus: 0
  assign teaser_s = section.settings.teaser_days | times: 86400
  assign show_from = start_s | minus: teaser_s
  assign visible = false
  if section.settings.enabled and end_s > now_s and now_s >= show_from
    assign visible = true
  endif
-%}
{%- if section.settings.enabled and end_s > 0 -%}
<div class="hvx-cd" id="hvx-cd-{{ section.id }}"{% unless visible %} hidden{% endunless %}
     data-start="{{ start_s }}" data-end="{{ end_s }}" data-teaser="{{ show_from }}"
     style="--cd-bg:{{ section.settings.bg }};--cd-fg:{{ section.settings.fg }};--cd-accent:{{ section.settings.accent }}">
  <a class="hvx-cd__in" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
    <span class="hvx-cd__msg" data-cd-msg data-before="{{ section.settings.before | escape }}" data-during="{{ section.settings.during | escape }}">{% if now_s < start_s %}{{ section.settings.before }}{% else %}{{ section.settings.during }}{% endif %}</span>
    <span class="hvx-cd__time" data-cd-time aria-live="off">
      <span><b data-d>0</b>d</span><span><b data-h>00</b>h</span><span><b data-m>00</b>m</span><span class="hvx-cd__s"><b data-s>00</b>s</span>
    </span>
    {%- if section.settings.cta != blank -%}<span class="hvx-cd__cta">{{ section.settings.cta }} →</span>{%- endif -%}
  </a>
</div>
<script>
(function(){
  var el=document.getElementById('hvx-cd-{{ section.id }}'); if(!el)return;
  var start=+el.dataset.start*1000,end=+el.dataset.end*1000,teaser=+el.dataset.teaser*1000;
  var msg=el.querySelector('[data-cd-msg]'),q=function(s){return el.querySelector(s)};
  var D=q('[data-d]'),H=q('[data-h]'),M=q('[data-m]'),S=q('[data-s]');
  function pad(n){return n<10?'0'+n:''+n}
  function tick(){
    var now=Date.now();
    if(now>=end||now<teaser){el.hidden=true;return false;}
    el.hidden=false;
    var target=now<start?start:end;
    msg.textContent=now<start?msg.dataset.before:msg.dataset.during;
    var t=Math.max(0,Math.floor((target-now)/1000));
    D.textContent=Math.floor(t/86400);H.textContent=pad(Math.floor(t%86400/3600));M.textContent=pad(Math.floor(t%3600/60));S.textContent=pad(t%60);
    return true;
  }
  if(tick()){var iv=setInterval(function(){if(!tick())clearInterval(iv);},1000);}
})();
</script>
{%- endif -%}
{% schema %}
{"name":"Havoc sale countdown","tag":"div","class":"hvx-s-cd",
"settings":[
{"type":"checkbox","id":"enabled","label":"Show countdown","default":true},
{"type":"text","id":"start","label":"Sale starts","info":"Format: 2026-11-17 00:00 -0500 (date, time, timezone)","default":"2026-11-17 00:00 -0500"},
{"type":"text","id":"end","label":"Sale ends","default":"2026-11-30 23:59 -0500"},
{"type":"range","id":"teaser_days","label":"Show countdown this many days early","min":0,"max":14,"step":1,"default":3},
{"type":"text","id":"before","label":"Message before the sale","default":"Black Friday Sale · up to 40% off · starts in"},
{"type":"text","id":"during","label":"Message during the sale","default":"Black Friday Sale · up to 40% off · ends in"},
{"type":"text","id":"cta","label":"Link text","default":"Shop the sale"},
{"type":"url","id":"link","label":"Link"},
{"type":"color","id":"bg","label":"Background","default":"#0b0b0c"},
{"type":"color","id":"fg","label":"Text","default":"#ffffff"},
{"type":"color","id":"accent","label":"Accent","default":"#d4111e"}],
"presets":[{"name":"Havoc sale countdown"}]}
{% endschema %}
