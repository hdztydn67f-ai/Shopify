{%- comment -%}
  Product page extras (sits right under the main product): at-a-glance specs, trust row,
  payment icons, size guide and helpful links. Minimal, no fake urgency.
{%- endcomment -%}
{%- liquid
  assign t = product.type | downcase
  assign is_glove = false
  if t contains 'glove' or t contains 'set' or t contains 'kit'
    assign is_glove = true
  endif
  assign is_shoe = false
  if t contains 'shoe' or t contains 'boot'
    assign is_shoe = true
  endif
  assign size_opt = nil
  assign closure_opt = nil
  for o in product.options_with_values
    assign on = o.name | downcase
    if on contains 'size' or on contains 'weight'
      assign size_opt = o
    elsif on contains 'closure' or on contains 'style'
      assign closure_opt = o
    endif
  endfor
-%}
<section class="hvx hvx-sec hvx-sec--tight hvx-pdp">
  <div class="hvx-wrap">
    <div class="hvx-pdp__grid">
      <div class="hvx-pdp__card">
        <h2 class="hvx-pdp__h">Details</h2>
        <dl class="hvx-specs">
          {%- if product.vendor != blank -%}<div><dt>Brand</dt><dd>{{ product.vendor }}</dd></div>{%- endif -%}
          {%- if product.type != blank -%}<div><dt>Category</dt><dd>{{ product.type }}</dd></div>{%- endif -%}
          {%- if size_opt -%}<div><dt>{{ size_opt.name }}</dt><dd>{% if size_opt.values.size > 1 %}{{ size_opt.values.first }} – {{ size_opt.values.last }} ({{ size_opt.values.size }} options){% else %}{{ size_opt.values.first }}{% endif %}</dd></div>{%- endif -%}
          {%- if closure_opt -%}<div><dt>{{ closure_opt.name }}</dt><dd>{{ closure_opt.values | join: ' or ' }}</dd></div>{%- endif -%}
          <div><dt>Dispatch</dt><dd>{{ section.settings.dispatch }}</dd></div>
          <div><dt>Shipping</dt><dd>{{ section.settings.shipping }}</dd></div>
        </dl>
        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="hvx-pay" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'hvx-pay__i' }}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="hvx-pdp__card">
        <h2 class="hvx-pdp__h">Good to know</h2>
        <ul class="hvx-trust">
          {%- for b in section.blocks -%}
            <li {{ b.shopify_attributes }}>
              {%- case b.settings.icon -%}
                {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                {%- when 'chat' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4h4"/></svg>
              {%- endcase -%}
              <span><b>{{ b.settings.title }}</b>{{ b.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>

    {%- if is_glove and section.settings.show_sizes -%}
      <div class="hvx-faq hvx-pdp__acc">
        <details><summary>Glove size guide: which weight should I buy?</summary>
          <div class="hvx-faq__a">
            <table class="hvx-sizes">
              <thead><tr><th>Weight</th><th>Best for</th><th>Typical user</th></tr></thead>
              <tbody>
                <tr><td>6oz – 10oz</td><td>Speed, pad and mitt work</td><td>Youth, smaller hands, pad drills</td></tr>
                <tr><td>12oz – 14oz</td><td>Heavy bag, general training</td><td>Most beginners, all-round training</td></tr>
                <tr><td>16oz</td><td>Sparring</td><td>Standard adult sparring weight</td></tr>
                <tr><td>18oz</td><td>Sparring, extra protection</td><td>Heavier boxers, about 90kg / 200lb and up</td></tr>
              </tbody>
            </table>
            <p style="margin:14px 0 0">Between sizes? Go heavier for sparring and lighter for pads. Read the full <a href="/blogs/news/what-size-boxing-gloves-should-i-buy">boxing glove size guide</a> or compare <a href="/blogs/news/lace-up-vs-hook-and-loop-boxing-gloves">lace-up vs velcro</a>.</p>
          </div>
        </details>
      </div>
    {%- elsif is_shoe -%}
      <div class="hvx-faq hvx-pdp__acc">
        <details><summary>Boxing shoe sizing tips</summary>
          <div class="hvx-faq__a"><p>Most boots here are listed in US sizes; check the size selector above for this pair. Boxing boots are made for a snug, locked-in fit, so measure your foot length before ordering. If you are between sizes or have wide feet, <a href="/pages/contact">message us</a> before you buy and we will help you choose.</p></div>
        </details>
      </div>
    {%- endif -%}

    {%- liquid
      assign links = ''
      for c in product.collections
        if c.handle == 'frontpage' or c.handle == 'all'
          continue
        endif
        assign links = links | append: '<a href="' | append: c.url | append: '">' | append: c.title | append: '</a>'
      endfor
    -%}
    {%- if links != blank -%}
      <nav class="hvx-chips" aria-label="Related collections"><span>Explore:</span>{{ links }}<a href="/pages/contact">Custom orders</a></nav>
    {%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Havoc product extras","tag":"div","class":"hvx-s-assure",
"settings":[
{"type":"checkbox","id":"show_sizes","label":"Show size guide on gloves, sets and shoes","default":true},
{"type":"text","id":"dispatch","label":"Dispatch line","default":"1–3 business days"},
{"type":"text","id":"shipping","label":"Shipping line","default":"Tracked & insured: DHL, FedEx, UPS"}],
"blocks":[{"type":"i","name":"Trust point","limit":4,"settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"truck","label":"Shipping"},{"value":"lock","label":"Secure"},{"value":"return","label":"Returns"},{"value":"chat","label":"Support"}],"default":"truck"},{"type":"text","id":"title","label":"Title"},{"type":"text","id":"text","label":"Text"}]}],
"presets":[{"name":"Havoc product extras"}]}
{% endschema %}
