<section class="hvx hvx-sec">
  <div class="hvx-wrap">
    <div class="hvx-head hvx-head--center hvx-reveal"><div>{%- if section.settings.eyebrow != blank -%}<p class="hvx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="hvx-h2">{{ section.settings.heading }}</h2></div></div>
    <div class="hvx-cats">
      {%- for b in section.blocks -%}
        {%- assign c = b.settings.collection -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        {%- assign im = b.settings.image | default: b.settings.product.featured_image | default: c.products.first.featured_image | default: c.image -%}
        <a class="hvx-cat hvx-reveal" href="{{ c.url }}" {{ b.shopify_attributes }}>
          <span class="hvx-cat__img">{%- if im -%}{%- assign hvx_alt = b.settings.title | default: c.title -%}{{ im | image_url: width: 480 | image_tag: loading: 'lazy', widths: '200,320,480', sizes: '(min-width:990px) 180px, 31vw', alt: hvx_alt }}{%- endif -%}</span>
          <span class="hvx-cat__name">{{ b.settings.title | default: c.title }}</span>
          <span class="hvx-cat__count">{{ c.products_count }} products</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_text != blank -%}<p style="text-align:center;margin:30px 0 0"><a class="hvx-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_text }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Havoc shop by category","tag":"div","class":"hvx-s-cats",
"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by category"},{"type":"text","id":"heading","label":"Heading","default":"Everything for the ring"},{"type":"text","id":"link_text","label":"Link text","default":"All products"},{"type":"url","id":"link","label":"Link"}],
"blocks":[{"type":"cat","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"product","id":"product","label":"Product photo to show"},{"type":"text","id":"title","label":"Label"},{"type":"image_picker","id":"image","label":"Image override (optional)"}]}],
"presets":[{"name":"Havoc shop by category"}]}
{% endschema %}
