<section class="hvx hvx-sec hvx-sec--mist">
  <div class="hvx-wrap">
    <div class="hvx-head"><div>{%- if section.settings.eyebrow != blank -%}<p class="hvx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 class="hvx-h2">{{ section.settings.heading }}</h2></div>{%- if section.settings.link_text != blank -%}<a class="hvx-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_text }}</a>{%- endif -%}</div>
    <div class="hvx-cats">
      {%- for b in section.blocks -%}
        {%- assign c = b.settings.collection -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        {%- assign im = b.settings.image | default: c.image | default: c.products.first.featured_image -%}
        <a class="hvx-cat" href="{{ c.url }}" {{ b.shopify_attributes }}>
          <span class="hvx-cat__img" style="display:block">{%- if im -%}{{ im | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,375,500', sizes: '(min-width:990px) 16vw, (min-width:550px) 33vw, 50vw', alt: b.settings.title | default: c.title }}{%- endif -%}</span>
          <span class="hvx-cat__name">{{ b.settings.title | default: c.title }}</span>
          <span class="hvx-cat__count">{{ c.products_count }} products</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Havoc shop by category","tag":"div","class":"hvx-s-cats",
"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by category"},{"type":"text","id":"heading","label":"Heading","default":"Everything for the ring"},{"type":"text","id":"link_text","label":"Link text","default":"All categories"},{"type":"url","id":"link","label":"Link"}],
"blocks":[{"type":"cat","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"title","label":"Label"},{"type":"image_picker","id":"image","label":"Image (optional)"}]}],
"presets":[{"name":"Havoc shop by category"}]}
{% endschema %}
