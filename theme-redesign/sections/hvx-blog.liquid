{%- assign bl = section.settings.blog | default: blogs.news -%}
{%- if bl.articles_count > 0 -%}
<section class="hvx hvx-sec">
  <div class="hvx-wrap">
    <div class="hvx-head"><div><p class="hvx-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="hvx-h2">{{ section.settings.heading }}</h2></div><a class="hvx-link" href="{{ bl.url }}">All guides</a></div>
    <div class="hvx-posts">
      {%- for a in bl.articles limit: 3 -%}
        <a class="hvx-post" href="{{ a.url }}">
          <div class="hvx-post__img">{%- if a.image -%}{%- assign hvx_alt = a.image.alt | default: a.title -%}{{ a.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width:750px) 33vw, 100vw', alt: hvx_alt }}{%- else -%}<span class="hvx-post__ph">{{ a.title }}</span>{%- endif -%}</div>
          <h3>{{ a.title }}</h3>
          <p>{{ a.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Havoc guides","tag":"div","class":"hvx-s-blog",
"settings":[{"type":"blog","id":"blog","label":"Blog"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fight smarter"},{"type":"text","id":"heading","label":"Heading","default":"Boxing gear guides"}],
"presets":[{"name":"Havoc guides"}]}
{% endschema %}
