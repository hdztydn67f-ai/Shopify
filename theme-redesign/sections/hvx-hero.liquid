{%- liquid
  assign f = section.settings.head_font
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: img
-%}
<style>
{{ f | font_face: font_display: 'swap' }}
:root{--hvx-head-font:{{ f.family }},{{ f.fallback_families }}}
</style>
<link rel="preload" as="font" href="{{ f | font_url }}" type="font/woff2" crossorigin>
<section class="hvx hvx-hero" aria-label="{{ section.settings.heading | strip_html | escape }}">
  <div class="hvx-hero__media">
    {%- if img -%}
      <picture>
        {%- if img_m -%}<source media="(max-width:749px)" srcset="{{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1100 }} 1100w" sizes="100vw">{%- endif -%}
        {{ img | image_url: width: 1920 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '1100,1500,1920,2400', sizes: '100vw', alt: img.alt | default: section.settings.image_alt }}
      </picture>
    {%- endif -%}
  </div>
  <div class="hvx-wrap hvx-hero__body">
    {%- if section.settings.kicker != blank -%}<p class="hvx-hero__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1>{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h1>
    {%- if section.settings.sub != blank -%}<p class="hvx-hero__sub">{{ section.settings.sub }}</p>{%- endif -%}
    <div class="hvx-hero__ctas">
      {%- if section.settings.cta1 != blank -%}<a class="hvx-btn hvx-btn--red" href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}">{{ section.settings.cta1 }}</a>{%- endif -%}
      {%- if section.settings.cta2 != blank -%}<a class="hvx-btn hvx-btn--ghost" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2 }}</a>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="hvx-hero__proof">
        {%- for b in section.blocks -%}<li {{ b.shopify_attributes }}><strong>{{ b.settings.big }}</strong>{{ b.settings.small }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Havoc hero","tag":"div","class":"hvx-s-hero",
"settings":[
{"type":"font_picker","id":"head_font","label":"Heading font (used site-wide by Havoc sections)","default":"oswald_n7"},
{"type":"image_picker","id":"image","label":"Image (desktop)"},
{"type":"image_picker","id":"image_mobile","label":"Image (mobile)"},
{"type":"text","id":"image_alt","label":"Image alt text","default":"Professional boxing gloves and sparring gear"},
{"type":"text","id":"kicker","label":"Kicker","default":"Pro boxing gear"},
{"type":"text","id":"heading","label":"Heading (H1)","default":"Boxing Gloves &"},
{"type":"text","id":"heading_accent","label":"Heading accent (red)","default":"Sparring Gear"},
{"type":"textarea","id":"sub","label":"Subheading"},
{"type":"text","id":"cta1","label":"Button 1","default":"Shop gloves"},
{"type":"url","id":"cta1_link","label":"Button 1 link"},
{"type":"text","id":"cta2","label":"Button 2","default":"Shop sparring sets"},
{"type":"url","id":"cta2_link","label":"Button 2 link"}],
"blocks":[{"type":"proof","name":"Proof point","limit":4,"settings":[{"type":"text","id":"big","label":"Big text"},{"type":"text","id":"small","label":"Small text"}]}],
"presets":[{"name":"Havoc hero"}]}
{% endschema %}
