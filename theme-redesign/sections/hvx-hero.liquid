{%- liquid
  assign f = section.settings.head_font
  assign fp = section.settings.product
  assign img = section.settings.image | default: fp.featured_image
-%}
<style>
{{ f | font_face: font_display: 'swap' }}
:root{--hvx-head-font:{{ f.family }},{{ f.fallback_families }}}
</style>
<link rel="preload" as="font" href="{{ f | font_url }}" type="font/woff2" crossorigin>
<section class="hvx hvx-hero">
  <div class="hvx-wrap hvx-hero__grid">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="hvx-hero__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1>{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h1>
      {%- if section.settings.sub != blank -%}<p class="hvx-hero__sub">{{ section.settings.sub }}</p>{%- endif -%}
      <div class="hvx-hero__ctas">
        {%- if section.settings.cta1 != blank -%}<a class="hvx-btn hvx-btn--red" href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}">{{ section.settings.cta1 }}</a>{%- endif -%}
        {%- if section.settings.cta2 != blank -%}<a class="hvx-btn hvx-btn--line" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2 }}</a>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hvx-hero__proof">
          {%- for b in section.blocks -%}<li {{ b.shopify_attributes }}><strong>{{ b.settings.big }}</strong>{{ b.settings.small }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="hvx-hero__media" id="hvx-hm-{{ section.id }}">
      <div class="hvx-hero__stage">
        {%- if section.settings.watermark != blank -%}<span class="hvx-hero__word" aria-hidden="true">{{ section.settings.watermark }}</span>{%- endif -%}
        {%- if fp != blank and fp.compare_at_price > fp.price -%}
          {%- assign hvx_save = fp.compare_at_price | minus: fp.price | times: 100 | divided_by: fp.compare_at_price -%}
          {%- if hvx_save >= 5 -%}<span class="hvx-hero__save"><small>Save</small>{{ hvx_save }}%</span>{%- endif -%}
        {%- endif -%}
        <div class="hvx-hero__float">
          {%- if img -%}
            {%- assign hvx_alt = section.settings.image_alt | default: img.alt | default: fp.title -%}{{ img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1200,1400', sizes: '(min-width:900px) 48vw, 88vw', alt: hvx_alt, class: 'hvx-hero__main' }}
          {%- endif -%}
        </div>
        <span class="hvx-hero__floor" aria-hidden="true"></span>
      </div>
      {%- liquid
        assign thumbs = ''
        assign tcount = 0
        if section.settings.image == blank and fp != blank
          for m in fp.media
            if m.media_type != 'image'
              continue
            endif
            assign malt = m.alt | downcase
            if malt contains 'chart' or m.preview_image.width < 700
              continue
            endif
            assign tcount = tcount | plus: 1
            if tcount > 4
              break
            endif
          endfor
        endif
      -%}
      {%- if tcount > 1 -%}
        <div class="hvx-hero__thumbs" role="group" aria-label="More angles">
          {%- assign tn = 0 -%}
          {%- for m in fp.media -%}
            {%- if m.media_type != 'image' -%}{%- continue -%}{%- endif -%}
            {%- assign malt = m.alt | downcase -%}
            {%- if malt contains 'chart' or m.preview_image.width < 700 -%}{%- continue -%}{%- endif -%}
            {%- assign tn = tn | plus: 1 -%}{%- if tn > 4 -%}{%- break -%}{%- endif -%}
            {%- capture tset -%}{{ m.preview_image | image_url: width: 480 }} 480w, {{ m.preview_image | image_url: width: 720 }} 720w, {{ m.preview_image | image_url: width: 960 }} 960w, {{ m.preview_image | image_url: width: 1200 }} 1200w{%- endcapture -%}
            <button type="button" class="hvx-hero__thumb{% if tn == 1 %} is-on{% endif %}" aria-label="Show angle {{ tn }}" aria-pressed="{% if tn == 1 %}true{% else %}false{% endif %}" data-src="{{ m.preview_image | image_url: width: 1200 }}" data-srcset="{{ tset | strip }}" data-alt="{{ m.alt | default: fp.title | escape }}">{{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80, alt: '' }}</button>
          {%- endfor -%}
        </div>
        <script>
        (function(){
          var r=document.getElementById('hvx-hm-{{ section.id }}');if(!r)return;
          var main=r.querySelector('.hvx-hero__main');if(!main)return;
          r.addEventListener('click',function(e){
            var b=e.target.closest('.hvx-hero__thumb');if(!b)return;
            r.querySelectorAll('.hvx-hero__thumb').forEach(function(t){t.classList.remove('is-on');t.setAttribute('aria-pressed','false')});
            b.classList.add('is-on');b.setAttribute('aria-pressed','true');
            main.srcset=b.dataset.srcset;main.src=b.dataset.src;main.alt=b.dataset.alt;
          });
        })();
        </script>
      {%- endif -%}
      {%- if fp != blank -%}
        <a class="hvx-hero__tag" href="{{ fp.url }}"><small>{{ section.settings.tag_label | default: 'Best seller' }}</small><b>{{ fp.title | split: ' | ' | first }}</b><span>{% if fp.price_varies %}From {% endif %}{{ fp.price | money }}{% if fp.compare_at_price > fp.price %} <s>{{ fp.compare_at_price | money }}</s>{% endif %}</span></a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Havoc hero","tag":"div","class":"hvx-s-hero",
"settings":[
{"type":"font_picker","id":"head_font","label":"Heading font (used by all Havoc sections)","default":"oswald_n7"},
{"type":"product","id":"product","label":"Featured product (image + price tag)"},
{"type":"image_picker","id":"image","label":"Image override (use a white-background PNG)"},
{"type":"text","id":"image_alt","label":"Image alt text"},
{"type":"text","id":"tag_label","label":"Price tag label","default":"Best seller"},
{"type":"text","id":"watermark","label":"Big outline word behind the product","default":"HYPERKO"},
{"type":"text","id":"kicker","label":"Kicker","default":"Pro boxing gear"},
{"type":"text","id":"heading","label":"Heading (H1)","default":"Boxing Gloves,"},
{"type":"text","id":"heading_accent","label":"Heading accent (red)","default":"Boots & Sparring Gear"},
{"type":"textarea","id":"sub","label":"Subheading"},
{"type":"text","id":"cta1","label":"Button 1","default":"Shop best sellers"},
{"type":"url","id":"cta1_link","label":"Button 1 link"},
{"type":"text","id":"cta2","label":"Button 2","default":"Shop gloves"},
{"type":"url","id":"cta2_link","label":"Button 2 link"}],
"blocks":[{"type":"proof","name":"Proof point","limit":4,"settings":[{"type":"text","id":"big","label":"Big text"},{"type":"text","id":"small","label":"Small text"}]}],
"presets":[{"name":"Havoc hero"}]}
{% endschema %}
