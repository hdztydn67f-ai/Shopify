    "custom_liquid_VEDiL7": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"hv-why\"><div class=\"hv-wrap\"><p class=\"hv-kicker\">WHY FIGHTERS CHOOSE HAVOC</p><h2 class=\"hv-title\">Built for Fighters. <span>Made to Last.</span></h2><p class=\"hv-sub\">Every piece of Havoc gear is designed to take a beating in the gym, round after round, so you can focus on your training.</p><div class=\"hv-grid\"><div class=\"hv-card\"><div class=\"hv-ic\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 21h8M12 17v4M7 4h10v5a5 5 0 01-10 0z\"/><path d=\"M7 6H4a3 3 0 003 4M17 6h3a3 3 0 01-3 4\"/></svg></div><h3>Built for Every Level</h3><p>From your first class to fight night, gear that keeps up with your progress.</p></div><div class=\"hv-card\"><div class=\"hv-ic\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 7l8-4 8 4v10l-8 4-8-4z\"/><path d=\"M4 7l8 4 8-4M12 11v10\"/></svg></div><h3>Premium Materials</h3><p>Quality leather and reinforced stitching built for hard, everyday training.</p></div><div class=\"hv-card\"><div class=\"hv-ic\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg></div><h3>Engineered Protection</h3><p>Dense, shock-absorbing padding helps protect your hands, head and body.</p></div><div class=\"hv-card\"><div class=\"hv-ic\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 12l3 3 5-6\"/></svg></div><h3>Quality Checked</h3><p>Every item is inspected before it leaves our workshop.</p></div><div class=\"hv-card\"><div class=\"hv-ic\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18\"/></svg></div><h3>Worldwide Shipping</h3><p>From our workshop to your gym, wherever you train.</p></div><div class=\"hv-card\"><div class=\"hv-ic\"><svg viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 018 0v4\"/></svg></div><h3>Secure Checkout</h3><p>Your payment details are encrypted and protected.</p></div></div><button type=\"button\" class=\"hv-cta\" onclick=\"window.scrollTo({top:0,behavior:'smooth'})\">GEAR UP NOW</button></div></section>\n<style>.hv-why{background:radial-gradient(circle at 50% 0,#2b2b2b 0,#111 70%);color:#fff;padding:56px 16px;text-align:center;overflow:hidden}.hv-wrap{max-width:1100px;margin:0 auto}.hv-kicker{color:#e8b64c;letter-spacing:3px;font-size:12px;font-weight:700;margin:0 0 10px}.hv-title{color:#fff;font-size:clamp(26px,5vw,42px);font-weight:900;text-transform:uppercase;line-height:1.1;margin:0 0 14px}.hv-title span{color:#e8b64c}.hv-sub{color:#bbb;max-width:620px;margin:0 auto 36px;font-size:15px;line-height:1.6}.hv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.hv-card{background:#1b1b1b;border:1px solid #2e2e2e;border-radius:14px;padding:26px 18px;transition:transform .3s,border-color .3s,box-shadow .3s}.hv-card:hover{transform:translateY(-6px);border-color:#e8b64c;box-shadow:0 10px 30px rgba(232,182,76,.18)}.hv-ic{width:56px;height:56px;margin:0 auto 14px;border-radius:50%;background:linear-gradient(135deg,#e8b64c,#b8862a);display:flex;align-items:center;justify-content:center}.hv-ic svg{width:28px;height:28px;fill:none;stroke:#111;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.hv-card h3{color:#fff;font-size:17px;font-weight:800;margin:0 0 8px;text-transform:uppercase;letter-spacing:.5px}.hv-card p{color:#aaa;font-size:14px;line-height:1.5;margin:0}.hv-cta{margin-top:36px;background:#e8b64c;color:#111;border:0;border-radius:50px;padding:15px 42px;font-weight:900;letter-spacing:2px;font-size:15px;cursor:pointer;transition:transform .2s,background .2s;animation:hvPulse 2.2s infinite}.hv-cta:hover{background:#fff;transform:scale(1.05)}@keyframes hvPulse{0%,100%{box-shadow:0 0 0 0 rgba(232,182,76,.6)}50%{box-shadow:0 0 0 14px rgba(232,182,76,0)}}@media(max-width:749px){.hv-grid{grid-template-columns:repeat(2,1fr);gap:12px}.hv-card{padding:18px 12px}.hv-card h3{font-size:14px}.hv-card p{font-size:12.5px}.hv-why{padding:44px 14px}}</style>"
      }
    },
