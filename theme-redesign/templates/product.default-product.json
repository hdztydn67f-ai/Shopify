        "3d9ea84d-5527-4bce-abe6-5debef3ec955": {
          "type": "custom",
          "settings": {
            "open_tab_mobile": false,
            "title": "Shipping & Return",
            "type": "all",
            "content": "<h3>Shipping</h3><p>Every order ships fully tracked and insured with DHL, FedEx or UPS to the USA, the UK, Europe, Canada and over 150 countries. Standard stock is dispatched in 1–3 business days and transit usually takes 3–5 business days. The exact shipping cost for your address is shown at checkout before you pay. Import duties or VAT may apply in some countries.</p><h3>Returns</h3><p>You can return unused stock items in their original packaging within 14 days of delivery. Custom-made gear (names, logos or custom designs) cannot be returned unless it has a manufacturing defect. If your order arrives damaged or faulty, contact us within 48 hours of delivery with your order number and photos.</p><p>Read the full <a href=\"/policies/shipping-policy\">shipping policy</a> and <a href=\"/policies/refund-policy\">refund policy</a>, or <a href=\"/pages/contact\">contact us</a> with any question before you order.</p>",
            "product_custom_source": "dynamic",
            "product_tab_key_metafield": "",
            "enable_btn_show_more": false,
            "maximum_des_to_show": 300
          }
        },
        "b9d6eb19-10f4-41f8-bfdc-ea10e8b3182a": {
          "type": "custom",
          "settings": {
            "open_tab_mobile": false,
            "title": "Additional Information",
            "type": "all",
            "content": "<h3>Why buy from Havoc Boxing</h3><ul><li><strong>Tracked worldwide shipping:</strong> DHL, FedEx and UPS, insured on every order.</li><li><strong>Secure checkout:</strong> cards, Shop Pay, Apple Pay and Google Pay.</li><li><strong>Every glove weight:</strong> most gloves from 6oz to 18oz, lace-up or velcro.</li><li><strong>Custom gear with no minimum:</strong> one pair or a full gym order. <a href=\"/pages/contact\">Ask about custom</a>.</li></ul><p>Need help choosing a weight? Read our <a href=\"/blogs/news/what-size-boxing-gloves-should-i-buy\">boxing glove size guide</a>.</p>",
            "product_custom_source": "dynamic",
            "product_tab_key_metafield": "",
            "enable_btn_show_more": false,
            "maximum_des_to_show": 300
          }
        },
        "custom_PGbDLb": {
          "type": "custom",
          "settings": {
            "open_tab_mobile": false,
            "title": "Collection",
            "type": "all",
            "content": "<div style=\"margin-top: 30px; font-family: 'Arial Black', sans-serif; color: #111;\">\n\n  <!-- Product Main Image -->\n  <div style=\"text-align: center; margin-bottom: 25px;\">\n    <img \n      src=\"{{ product.featured_image | image_url: width: 600 }}\" \n      alt=\"{{ product.title }}\" \n      style=\"max-width: 100%; height: auto; border: 4px solid #d41414; border-radius: 12px; box-shadow: 0 0 20px rgba(212,20,20,0.4);\"\n    />\n    <h2 style=\"margin-top: 15px; font-size: 24px; font-weight: 900; text-transform: uppercase; color: #d41414; letter-spacing: 1px;\">\n      🥊 {{ product.title }}\n    </h2>\n  </div>\n\n  <!-- Collections the Product Belongs To -->\n  {% if product.collections.size > 0 %}\n    <h3 style=\"font-size: 20px; font-weight: bold; margin-bottom: 15px; text-transform: uppercase; color: #000; border-left: 5px solid gold; padding-left: 10px;\">\n      Part of these Collections:\n    </h3>\n    <div style=\"display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;\">\n      {% for collection in product.collections %}\n        <div style=\"width: 220px; text-align: center; background: #111; border: 2px solid #d41414; border-radius: 10px; padding: 12px; transition: all 0.3s ease; box-shadow: 0 0 12px rgba(0,0,0,0.4);\">\n          <a href=\"{{ collection.url }}\" style=\"text-decoration: none; color: #fff; display: block;\">\n            <img \n              src=\"{{ collection.image | image_url: width: 400 }}\" \n              alt=\"{{ collection.title }}\" \n              style=\"width: 100%; height: auto; border-radius: 8px; margin-bottom: 10px; border: 2px solid gold;\"\n            />\n            <span style=\"font-size: 16px; font-weight: 700; text-transform: uppercase; color: gold; letter-spacing: 0.5px;\">\n              {{ collection.title }}\n            </span>\n          </a>\n        </div>\n      {% endfor %}\n    </div>\n  {% else %}\n    <p style=\"text-align: center; font-size: 16px; font-weight: 600; color: #555;\">\n      This product is not assigned to any collection.\n    </p>\n  {% endif %}\n</div>",
            "product_custom_source": "dynamic",
            "product_tab_key_metafield": "",
            "enable_btn_show_more": false,
            "maximum_des_to_show": 300
          },
          "disabled": true
        },
