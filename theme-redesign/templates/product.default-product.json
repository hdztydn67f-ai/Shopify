    "custom_liquid_TgkL6K": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  Havoc Boxing - Smooth Product Page FAQ Accordion & Schema\n{% endcomment %}\n\n<div class=\"havoc-faq-wrapper\">\n  <div class=\"havoc-faq-header\">\n    <h2 class=\"havoc-faq-title\">Frequently Asked Questions</h2>\n    <p class=\"havoc-faq-subtitle\">Everything you need to know about our gloves, footwear, sparring sets & store policies.</p>\n  </div>\n\n  <div class=\"havoc-faq-list\">\n    <!-- Item 1 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">What materials are Havoc Boxing gloves crafted from?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>Our gloves are handcrafted from 100% genuine top-grain cowhide leather with multi-layered high-density foam padding. This ensures maximum knuckle protection, superior shock absorption, and long-lasting durability through heavy bag work, pad drills, and sparring.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 2 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">How do I choose the right boxing glove size (oz)?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>Glove weight depends on your intended training and body weight:</p>\n          <ul>\n            <li><strong>10 oz – 12 oz:</strong> Best for speed work, focus mitts, and light bag drills.</li>\n            <li><strong>14 oz:</strong> Ideal all-around weight for heavy bag workouts and general training.</li>\n            <li><strong>16 oz – 18 oz:</strong> Mandatory for safe sparring to protect both you and your training partners.</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 3 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">How do Havoc Boxing shoes/boots fit compared to standard sneakers?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>Havoc Boxing boots fit true to size with a snug, athletic profile designed to prevent foot slippage on the canvas. If you have wide feet or prefer extra room for thick training socks and ankle wraps, we recommend ordering a half size up.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 4 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">What is included in a Havoc Boxing Complete Sparring Set?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>Our full sparring sets include a matched pair of premium boxing gloves (14 oz or 16 oz), a full-face or cheek-protection headguard, and a no-foul groin protector, giving you unified protection and a matching gym look.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 5 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">Can I order custom colors, sizes, or personalized logos on my gear?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>Yes. We offer complete custom design options for gloves, sparring sets, and boots—including custom leather colorways, embroidery, and gym logos. Contact our support team or use our custom order inquiry form before placing your order.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 6 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">What payment methods do you accept, and are transactions secure?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>We accept all major credit/debit cards (Visa, Mastercard, American Express), PayPal, Apple Pay, and Google Pay. All transactions are encrypted via 256-bit SSL technology, ensuring your payment details remain strictly protected and confidential.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 7 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">How long does international shipping and order processing take?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>Standard orders are processed within 1–3 business days. International express delivery typically takes 5–8 business days with end-to-end tracking provided via email as soon as your parcel ships.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 8 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">Will I have to pay import duties or customs taxes?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>For most major international destinations, orders clear standard courier networks smoothly. Any local import duties, taxes, or clearance fees assessed by your destination customs authority remain the responsibility of the recipient.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 9 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">How do I clean and maintain my leather boxing gear?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>Wipe your gloves, headguards, and boots down with a damp cloth after every session. Never submerge genuine leather in water or dry it under direct sunlight or extreme heat. Use glove deodorizers and let them air out in a well-ventilated area.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Item 10 -->\n    <div class=\"havoc-faq-item\">\n      <button type=\"button\" class=\"havoc-faq-toggle\" aria-expanded=\"false\">\n        <span class=\"havoc-faq-q-text\">What is your return and exchange policy?</span>\n        <span class=\"havoc-faq-icon\"></span>\n      </button>\n      <div class=\"havoc-faq-collapse\">\n        <div class=\"havoc-faq-body\">\n          <p>We offer a 14-day return and exchange policy for unused items in their original packaging and condition. If your shoes or gloves do not fit as expected, reach out to our customer support team to arrange an easy size exchange.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- SEO FAQ Schema Markup -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What materials are Havoc Boxing gloves crafted from?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Handcrafted from 100% genuine top-grain cowhide leather with multi-layered high-density foam padding for shock absorption and durability.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do I choose the right boxing glove size (oz)?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"10-12 oz for speed and pads, 14 oz for heavy bag training, and 16-18 oz for safe sparring.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do Havoc Boxing shoes/boots fit compared to standard sneakers?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"They fit true to size with a snug athletic profile. For wide feet or thick wraps, we recommend sizing up a half size.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is included in a Havoc Boxing Complete Sparring Set?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Full sparring sets include matched boxing gloves (14 or 16 oz), a protective headguard, and a no-foul groin protector.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I order custom colors, sizes, or personalized logos on my gear?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes, Havoc Boxing offers custom colors, embroidery, and gym logos on all equipment.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What payment methods do you accept, and are transactions secure?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We accept Visa, Mastercard, AMEX, PayPal, Apple Pay, and Google Pay encrypted with 256-bit SSL technology.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does international shipping and order processing take?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Processing takes 1-3 business days and international delivery takes 5-8 business days with tracking.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Will I have to pay import duties or customs taxes?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Local customs duties and taxes are assessed by destination countries and remain the recipient's responsibility.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do I clean and maintain my leather boxing gear?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Wipe with a damp cloth, air dry naturally, and avoid soaking or direct sun exposure.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is your return and exchange policy?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We offer a 14-day return and exchange policy on unused items in original packaging.\"\n      }\n    }\n  ]\n}\n</script>\n\n<style>\n  .havoc-faq-wrapper {\n    max-width: 920px;\n    margin: 40px auto;\n    padding: 0 16px;\n    box-sizing: border-box;\n  }\n\n  .havoc-faq-header {\n    text-align: center;\n    margin-bottom: 28px;\n  }\n\n  .havoc-faq-title {\n    font-size: 28px !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n    color: #111111 !important;\n    margin: 0 0 10px 0 !important;\n    line-height: 1.3 !important;\n  }\n\n  .havoc-faq-subtitle {\n    font-size: 16px !important;\n    color: #555555 !important;\n    margin: 0 !important;\n    line-height: 1.5 !important;\n  }\n\n  .havoc-faq-list {\n    border-top: 1px solid #e2e2e2;\n  }\n\n  .havoc-faq-item {\n    border-bottom: 1px solid #e2e2e2;\n  }\n\n  .havoc-faq-toggle {\n    width: 100% !important;\n    background: transparent !important;\n    border: none !important;\n    outline: none !important;\n    box-shadow: none !important;\n    display: flex !important;\n    justify-content: space-between !important;\n    align-items: center !important;\n    padding: 20px 8px !important;\n    text-align: left !important;\n    cursor: pointer !important;\n    transition: background-color 0.2s ease;\n  }\n\n  .havoc-faq-toggle:hover {\n    background-color: #f9f9f9 !important;\n  }\n\n  .havoc-faq-q-text {\n    font-size: 18px !important;\n    font-weight: 700 !important;\n    color: #111111 !important;\n    line-height: 1.4 !important;\n    padding-right: 16px;\n  }\n\n  .havoc-faq-icon {\n    position: relative;\n    width: 16px;\n    height: 16px;\n    flex-shrink: 0;\n  }\n\n  .havoc-faq-icon::before,\n  .havoc-faq-icon::after {\n    content: '';\n    position: absolute;\n    background-color: #111111;\n    transition: transform 0.25s ease, opacity 0.25s ease;\n  }\n\n  .havoc-faq-icon::before {\n    top: 7px;\n    left: 0;\n    width: 16px;\n    height: 2px;\n  }\n\n  .havoc-faq-icon::after {\n    top: 0;\n    left: 7px;\n    width: 2px;\n    height: 16px;\n  }\n\n  /* Active / Open state styling */\n  .havoc-faq-item.is-active .havoc-faq-icon::after {\n    transform: rotate(90deg);\n    opacity: 0;\n  }\n\n  .havoc-faq-collapse {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .havoc-faq-body {\n    padding: 0 8px 22px 8px;\n    font-size: 16px !important;\n    line-height: 1.7 !important;\n    color: #333333 !important;\n  }\n\n  .havoc-faq-body p {\n    margin: 0 0 12px 0 !important;\n    font-size: 16px !important;\n    color: #333333 !important;\n  }\n\n  .havoc-faq-body ul {\n    margin: 8px 0 12px 24px !important;\n    padding: 0 !important;\n  }\n\n  .havoc-faq-body li {\n    font-size: 16px !important;\n    color: #333333 !important;\n    margin-bottom: 6px !important;\n  }\n\n  @media (max-width: 600px) {\n    .havoc-faq-title {\n      font-size: 22px !important;\n    }\n    .havoc-faq-q-text {\n      font-size: 16px !important;\n    }\n    .havoc-faq-body,\n    .havoc-faq-body p,\n    .havoc-faq-body li {\n      font-size: 15px !important;\n    }\n  }\n</style>\n\n<script>\n  (function initHavocFaq() {\n    function setupAccordion() {\n      const toggles = document.querySelectorAll('.havoc-faq-toggle');\n      toggles.forEach((button) => {\n        // Prevent duplicate event listeners if theme reloads scripts\n        if (button.dataset.faqInit) return;\n        button.dataset.faqInit = \"true\";\n\n        button.addEventListener('click', function () {\n          const item = this.closest('.havoc-faq-item');\n          const collapse = item.querySelector('.havoc-faq-collapse');\n          const isExpanded = this.getAttribute('aria-expanded') === 'true';\n\n          if (isExpanded) {\n            collapse.style.maxHeight = null;\n            item.classList.remove('is-active');\n            this.setAttribute('aria-expanded', 'false');\n          } else {\n            collapse.style.maxHeight = collapse.scrollHeight + \"px\";\n            item.classList.add('is-active');\n            this.setAttribute('aria-expanded', 'true');\n          }\n        });\n      });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', setupAccordion);\n    } else {\n      setupAccordion();\n    }\n  })();\n</script>"
      },
      "disabled": true
    },
