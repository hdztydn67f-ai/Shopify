  "faq": {
   "type": "hvx-faq",
   "settings": {
    "eyebrow": "FAQ",
    "heading": "Questions before you buy"
   },
   "blocks": {
    "qa_1": {
     "type": "qa",
     "settings": {
      "q": "Which boxing brands do you sell?",
      "a": "<p>We stock Nike boxing shoes (Hyperko, Machomai and Tawa), Winning, Cleto Reyes and No Boxing No Life (NBNL) boxing gloves and sparring sets, plus headgear, groin guards and focus mitts.</p>"
     }
    },
    "qa_2": {
     "type": "qa",
     "settings": {
      "q": "What size boxing gloves should I buy?",
      "a": "<p>Choose 8oz–10oz for pads and speed, 12oz–14oz for heavy bag and general training, 16oz for adult sparring and 18oz for heavier boxers. See our <a href=\"/blogs/news/what-size-boxing-gloves-should-i-buy\">glove size guide</a>.</p>"
     }
    },
    "qa_3": {
     "type": "qa",
     "settings": {
      "q": "Do you ship to the USA, UK, Europe and Canada?",
      "a": "<p>Yes. Every order ships tracked and insured with DHL, FedEx or UPS. The exact shipping cost is shown at checkout before you pay. Local import duties or VAT may apply in some countries.</p>"
     }
    },
    "qa_4": {
     "type": "qa",
     "settings": {
      "q": "How fast will my order arrive?",
      "a": "<p>Standard stock ships in 1–3 business days, then transit usually takes 3–5 business days. Custom gear timelines are confirmed with you before production starts.</p>"
     }
    },
    "qa_5": {
     "type": "qa",
     "settings": {
      "q": "Lace-up or velcro: which closure should I choose?",
      "a": "<p>Lace-up gives the tightest wrist support and suits sparring. Velcro (hook and loop) lets you glove up alone in seconds and suits bag work and classes. Read <a href=\"/blogs/news/lace-up-vs-hook-and-loop-boxing-gloves\">lace-up vs hook and loop</a>.</p>"
     }
    },
    "qa_6": {
     "type": "qa",
     "settings": {
      "q": "Can I order custom boxing gloves?",
      "a": "<p>Yes, with no minimum order. Tell us your colors, materials, names and logos through our <a href=\"/pages/contact\">contact page</a> and we will confirm the design and price.</p>"
     }
    },
    "qa_7": {
     "type": "qa",
     "settings": {
      "q": "What is your return policy?",
      "a": "<p>Unused stock items in their original packaging can be returned; custom-made items cannot be returned unless faulty. Full details are in our <a href=\"/policies/refund-policy\">refund policy</a>.</p>"
     }
    },
    "qa_8": {
     "type": "qa",
     "settings": {
      "q": "Which payment methods do you accept?",
      "a": "<p>Major credit and debit cards, Shop Pay, Apple Pay and Google Pay, all through Shopify’s secure checkout.</p>"
     }
    }
   },
