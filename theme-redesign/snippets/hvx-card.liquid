{%- comment -%} Havoc product card. Usage: render 'hvx-card', product: p, eager: false {%- endcomment -%}
{%- liquid
  assign img = product.featured_media.preview_image | default: product.featured_image
  assign img2 = product.media[1].preview_image
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign size_opt = nil
  for o in product.options_with_values
    assign on = o.name | downcase
    if on contains 'size' or on contains 'weight'
      assign size_opt = o
      break
    endif
  endfor
-%}
<a class="hvx-card" href="{{ product.url }}">
  <div class="hvx-card__img">
    {%- if product.compare_at_price > product.price -%}
      <span class="hvx-badge">Save {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
    {%- elsif product.available == false -%}
      <span class="hvx-badge hvx-badge--soft">Sold out</span>
    {%- endif -%}
    {%- if img -%}
      {{ img | image_url: width: 600 | image_tag: loading: loading, widths: '300,450,600', sizes: '(min-width:990px) 25vw, (min-width:550px) 42vw, 72vw', alt: img.alt | default: product.title }}
      {%- if img2 -%}{{ img2 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width:990px) 25vw, 42vw', alt: '' }}{%- endif -%}
    {%- endif -%}
  </div>
  <div class="hvx-card__body">
    <span class="hvx-card__brand">{{ product.vendor }}</span>
    <h3 class="hvx-card__title">{{ product.title }}</h3>
    {%- if size_opt and size_opt.values.size > 1 -%}
      <span class="hvx-card__meta">{{ size_opt.values.first }} – {{ size_opt.values.last }}{% if product.options.size > 1 %} · {{ product.options.size }} options{% endif %}</span>
    {%- endif -%}
    <span class="hvx-card__price">
      {%- if product.price_varies -%}From {% endif -%}
      <span class="{% if product.compare_at_price > product.price %}hvx-sale{% endif %}">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
    </span>
  </div>
</a>
