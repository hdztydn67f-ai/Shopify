{%- comment -%}
  Single line item inside the Ajax cart drawer.
  Accepts: item (line_item), forloop (for the line index).
{%- endcomment -%}
<div
  class="cart-item"
  data-cart-item
  data-line="{{ forloop.index }}"
  data-variant-id="{{ item.variant.id }}"
  data-key="{{ item.key }}"
>
  <a class="cart-item__media media media--square" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 200
        | image_tag:
          class: 'cart-item__image',
          widths: '84, 168, 252',
          sizes: '84px',
          loading: 'lazy'
      }}
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>

    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__variant">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}{% unless forloop.last %} / {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    {%- for property in item.properties -%}
      {%- unless property.last == blank or property.first startswith '_' -%}
        <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
      {%- endunless -%}
    {%- endfor -%}

    <p class="cart-item__price">
      {%- if item.original_price > item.final_price -%}
        <s>{{ item.original_price | money }}</s>
      {%- endif -%}
      <span>{{ item.final_price | money }}</span>
    </p>

    {%- if item.line_level_discount_allocations.size > 0 -%}
      {%- for allocation in item.line_level_discount_allocations -%}
        <p class="cart-item__discount">
          {% render 'icon', name: 'tag' %}
          {{ allocation.discount_application.title }} (&minus;{{ allocation.amount | money }})
        </p>
      {%- endfor -%}
    {%- endif -%}

    <div class="cart-item__row">
      <div class="quantity" data-quantity>
        <button
          type="button"
          class="quantity__button"
          name="minus"
          aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
          data-quantity-minus
        >
          {% render 'icon', name: 'minus', size: 14 %}
        </button>
        <label class="visually-hidden" for="Quantity-{{ forloop.index }}">
          {{ 'products.product.quantity.label' | t }}
        </label>
        <input
          class="quantity__input"
          type="number"
          id="Quantity-{{ forloop.index }}"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          {% if item.variant.inventory_management and item.variant.inventory_policy == 'deny' %}
            max="{{ item.variant.inventory_quantity }}"
          {% endif %}
          data-quantity-input
          data-line="{{ forloop.index }}"
        >
        <button
          type="button"
          class="quantity__button"
          name="plus"
          aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
          data-quantity-plus
        >
          {% render 'icon', name: 'plus', size: 14 %}
        </button>
      </div>

      <div class="cart-item__line-price">
        <strong>{{ item.final_line_price | money }}</strong>
      </div>
    </div>

    <button
      type="button"
      class="cart-item__remove"
      data-cart-remove
      data-line="{{ forloop.index }}"
      aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
    >
      {{ 'sections.cart.remove' | t }}
    </button>

    {%- if item.variant.inventory_management and item.variant.inventory_policy == 'deny' and item.quantity > item.variant.inventory_quantity -%}
      <p class="cart-tool__status is-error">
        {{ 'sections.cart.only_left' | t: quantity: item.variant.inventory_quantity }}
      </p>
    {%- endif -%}
  </div>
</div>
