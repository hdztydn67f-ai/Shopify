{%- comment -%}
  Social icons driven by the global social settings.
  rel="noopener" on every external link; no icon renders for an empty setting.
{%- endcomment -%}
{%- liquid
  assign has_social = false
  if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_x_link != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="social-links" role="list">
    {%- if settings.social_instagram_link != blank -%}
      <li>
        <a class="social-links__link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_facebook_link != blank -%}
      <li>
        <a class="social-links__link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      <li>
        <a class="social-links__link" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M22 12s0-3.3-.4-4.9a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.3a2.6 2.6 0 0 0-1.8 1.8C2 8.7 2 12 2 12s0 3.3.4 4.9c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.3a2.6 2.6 0 0 0 1.8-1.8C22 15.3 22 12 22 12zM10 15V9l5 3z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}
      <li>
        <a class="social-links__link" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M16 3c.4 2 1.8 3.4 3.9 3.6v2.7c-1.4.1-2.8-.3-4-1.1v5.6a5.9 5.9 0 1 1-5.1-5.9v2.9a3 3 0 1 0 2.2 2.9V3z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_x_link != blank -%}
      <li>
        <a class="social-links__link" href="{{ settings.social_x_link }}" target="_blank" rel="noopener noreferrer" aria-label="X">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.5 3h3l-6.6 7.5L21.8 21h-6l-4.7-6.1L5.7 21h-3l7-8L2.6 3h6.2l4.2 5.6zm-1 16h1.7L7.6 4.7H5.8z"/>
          </svg>
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
