<div class="section customer-page">
  <div class="page-width page-width--narrow">
    <div class="customer-page__inner">
      <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
      <hr class="rule-accent">

      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <p class="newsletter__message newsletter__message--error" role="alert">
            {% render 'icon', name: 'alert', size: 16 %}
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" id="RegisterFirstName" class="field__input" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" id="RegisterLastName" class="field__input" name="customer[last_name]" autocomplete="family-name">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="RegisterEmail" class="field__input" name="customer[email]" autocomplete="email" autocapitalize="off" required>
        </div>
        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
          <input type="password" id="RegisterPassword" class="field__input" name="customer[password]" autocomplete="new-password" required>
        </div>

        <button type="submit" class="button button--primary button--full">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}

      <p class="customer-page__footer">
        {{ 'customer.register.has_account' | t }}
        <a class="customer-page__link" href="{{ routes.account_login_url }}">{{ 'customer.login.sign_in' | t }}</a>
      </p>
    </div>
  </div>
</div>
