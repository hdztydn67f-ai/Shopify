<div class="section customer-page">
  <div class="page-width page-width--narrow">
    <div class="customer-page__inner">
      <h1 class="h1">{{ 'customer.reset_password.title' | t }}</h1>
      <hr class="rule-accent">
      <p class="text-muted">{{ 'customer.reset_password.subtext' | t }}</p>

      {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <p class="newsletter__message newsletter__message--error" role="alert">
            {% render 'icon', name: 'alert', size: 16 %}
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input type="password" id="ResetPassword" class="field__input" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.confirm' | t }}</label>
          <input type="password" id="ResetPasswordConfirm" class="field__input" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>

        <button type="submit" class="button button--primary button--full">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>
