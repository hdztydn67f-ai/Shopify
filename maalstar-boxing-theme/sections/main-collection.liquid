{%- comment -%}
  ------------------------------------------------------------
  SECTION: main-collection
  Collection banner, faceted filtering, sorting, product grid and
  pagination. The whole section is re-rendered through the Section
  Rendering API when a filter changes, so filtering never reloads
  the page but every URL stays real and shareable.
  ------------------------------------------------------------
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --grid-columns-desktop: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
  }
{% endstyle %}

<div class="collection-section" id="CollectionSection-{{ section.id }}" data-collection-section>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs' %}
    {%- endif -%}

    {%- if section.settings.show_banner -%}
      <header class="collection-banner{% if collection.image and section.settings.show_collection_image %} collection-banner--with-image{% endif %}">
        {%- if collection.image and section.settings.show_collection_image -%}
          <div class="collection-banner__media">
            {%- comment -%}
              Raw <img> rather than image_tag: fetchpriority is not an
              image_tag parameter, and this is the LCP element.
            {%- endcomment -%}
            <img
              class="collection-banner__image"
              src="{{ collection.image | image_url: width: 1800 }}"
              srcset="
                {{ collection.image | image_url: width: 600 }} 600w,
                {{ collection.image | image_url: width: 900 }} 900w,
                {{ collection.image | image_url: width: 1200 }} 1200w,
                {{ collection.image | image_url: width: 1800 }} 1800w
              "
              sizes="100vw"
              width="{{ collection.image.width }}"
              height="{{ collection.image.height }}"
              alt="{{ collection.image.alt | default: collection.title | escape }}"
              loading="eager"
              fetchpriority="high"
            >
            <span class="collection-banner__overlay" aria-hidden="true"></span>
          </div>
        {%- endif -%}

        <div class="collection-banner__content">
          <h1 class="collection-banner__title h1">{{ collection.title }}</h1>
          {%- if collection.description != blank and section.settings.show_description -%}
            <div class="collection-banner__description rte">{{ collection.description }}</div>
          {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {% render 'facets',
          results: collection,
          section_id: section.id,
          enable_filtering: section.settings.enable_filtering,
          enable_sorting: section.settings.enable_sorting
        %}
      {%- endif -%}

      <div class="collection-grid" id="ProductGrid-{{ section.id }}" data-product-grid-container>
        {%- if collection.products.size > 0 -%}
          <ul class="product-grid" role="list">
            {%- for product in collection.products -%}
              <li class="product-grid__item">
                {% render 'product-card',
                  product: product,
                  index: forloop.index,
                  image_ratio: section.settings.image_ratio,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  show_wishlist: true,
                  show_quick_view: true,
                  show_quick_add: true,
                  show_second_image: true
                %}
              </li>
            {%- endfor -%}
          </ul>

          {%- assign grid_anchor = '#CollectionSection-' | append: section.id -%}
          {% render 'pagination', paginate: paginate, anchor: grid_anchor %}
        {%- else -%}
          <div class="collection-empty">
            <p class="collection-empty__title h3">{{ 'sections.collection.empty' | t }}</p>
            <p class="text-muted">{{ 'sections.collection.use_fewer_filters' | t }}</p>
            <a class="button button--secondary" href="{{ collection.url }}">
              {{ 'products.facets.clear_all' | t }}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}

    {%- comment -%}
      SEO copy below the grid: keeps keyword-rich content on the page
      without pushing products below the fold.
    {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="collection-seo">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'seo_text' -%}
              <div class="collection-seo__block" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="collection-seo__heading h3">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.content != blank -%}
                  <div class="rte">{{ block.settings.content }}</div>
                {%- endif -%}
              </div>

            {%- when 'faq' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  <span>{{ block.settings.question | escape }}</span>
                  {% render 'icon', name: 'chevron-down', class: 'accordion__chevron' %}
                </summary>
                <div class="accordion__panel rte">{{ block.settings.answer }}</div>
              </details>
          {%- endcase -%}
        {%- endfor -%}

        {%- comment -%} FAQPage schema earns expandable FAQ rows in search results. {%- endcomment -%}
        {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
        {%- if faqs.size > 0 -%}
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": [
                {%- for block in faqs -%}
                  {
                    "@type": "Question",
                    "name": {{ block.settings.question | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ block.settings.answer | strip_html | json }}
                    }
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          </script>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Banner" },
    { "type": "checkbox", "id": "show_banner", "label": "Show collection banner", "default": true },
    { "type": "checkbox", "id": "show_collection_image", "label": "Show collection image", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "header", "content": "Filtering and sorting" },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true,
      "info": "Filters are configured in the Search & Discovery app."
    },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Grid" },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "Show product rating", "default": false }
  ],
  "blocks": [
    {
      "type": "seo_text",
      "name": "SEO text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Placed below the grid so products stay above the fold. Write for buyers first — 150-300 words covering what the range is, who it suits and how to choose."
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What glove weight should I buy?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>10oz for competition, 12oz for bag and pad work, 14-16oz for sparring. Heavier gloves protect both you and your training partner.</p>"
        }
      ]
    }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
