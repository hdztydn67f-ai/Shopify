{%- comment -%}
  ------------------------------------------------------------
  SECTION: related-products
  Uses Shopify's Product Recommendations API. The section renders
  empty on first paint and theme.js swaps in the recommendations,
  so the product page's own load is never held up by them.
  ------------------------------------------------------------
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --grid-columns-desktop: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
  }
{% endstyle %}

<div
  class="related-products section"
  data-related-products
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
  data-intent="{{ section.settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-header section-header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__heading h2">{{ section.settings.heading | escape }}</h2>
          <hr class="rule-accent">
        {%- endif -%}
      </div>

      <ul class="product-grid" role="list">
        {%- for product in recommendations.products -%}
          <li class="product-grid__item">
            {% render 'product-card',
              product: product,
              index: forloop.index,
              image_ratio: section.settings.image_ratio,
              show_vendor: false,
              show_wishlist: true,
              show_quick_view: true,
              show_quick_add: true,
              show_second_image: true
            %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "class": "section-related-products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "COMPLETE THE KIT" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related",
      "info": "Complementary products come from the Search & Discovery app."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "square"
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
