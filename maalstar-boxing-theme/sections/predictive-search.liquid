{%- comment -%}
  ------------------------------------------------------------
  SECTION: predictive-search
  Rendered as a fragment by /search/suggest and injected into the
  header dropdown. Never rendered as a page section.
  ------------------------------------------------------------
{%- endcomment -%}
{%- if predictive_search.performed -%}
  <div class="predictive" data-predictive-results>
    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="predictive__group">
        <h2 class="predictive__heading">{{ 'general.search.products' | t }}</h2>
        <ul class="predictive__list" role="presentation">
          {%- for product in predictive_search.resources.products -%}
            <li>
              <a class="predictive__item" href="{{ product.url }}" role="option" data-predictive-item>
                <span class="predictive__media media media--square">
                  {%- if product.featured_media -%}
                    <img
                      src="{{ product.featured_media | image_url: width: 120 }}"
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                    >
                  {%- endif -%}
                </span>
                <span class="predictive__body">
                  <span class="predictive__title">{{ product.title }}</span>
                  <span class="predictive__price">
                    {%- if product.compare_at_price_max > product.price -%}
                      <s>{{ product.compare_at_price_max | money }}</s>
                    {%- endif -%}
                    {{ product.price | money }}
                  </span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.collections.size > 0 -%}
      <div class="predictive__group">
        <h2 class="predictive__heading">{{ 'general.search.collections' | t }}</h2>
        <ul class="predictive__list" role="presentation">
          {%- for collection in predictive_search.resources.collections -%}
            <li>
              <a class="predictive__item predictive__item--text" href="{{ collection.url }}" role="option" data-predictive-item>
                {% render 'icon', name: 'tag', size: 16 %}
                <span>{{ collection.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.pages.size > 0 or predictive_search.resources.articles.size > 0 -%}
      <div class="predictive__group">
        <h2 class="predictive__heading">{{ 'general.search.pages' | t }}</h2>
        <ul class="predictive__list" role="presentation">
          {%- for page in predictive_search.resources.pages -%}
            <li>
              <a class="predictive__item predictive__item--text" href="{{ page.url }}" role="option" data-predictive-item>
                {% render 'icon', name: 'note', size: 16 %}
                <span>{{ page.title }}</span>
              </a>
            </li>
          {%- endfor -%}
          {%- for article in predictive_search.resources.articles -%}
            <li>
              <a class="predictive__item predictive__item--text" href="{{ article.url }}" role="option" data-predictive-item>
                {% render 'icon', name: 'note', size: 16 %}
                <span>{{ article.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.products.size == 0
      and predictive_search.resources.collections.size == 0
      and predictive_search.resources.pages.size == 0
      and predictive_search.resources.articles.size == 0
    -%}
      <p class="predictive__empty">
        {{ 'general.search.no_results' | t: terms: predictive_search.terms }}
      </p>
    {%- else -%}
      <a class="predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}">
        {{ 'general.search.view_all_results' | t }}
        {% render 'icon', name: 'arrow-right', size: 14 %}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
