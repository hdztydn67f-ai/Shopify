{%- comment -%}
  ------------------------------------------------------------
  SECTION: hero-banner
  Full-bleed image or video hero. Carries the page's single <h1>
  on the homepage, so the heading text is the primary keyword slot.
  ------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign heading_tag = section.settings.heading_tag
  if heading_tag == blank
    assign heading_tag = 'h1'
  endif

  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .hero {
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-overlay-color: {{ section.settings.overlay_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-min-height: {{ section.settings.height_mobile }}vh;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hero {
      --hero-min-height: {{ section.settings.height_desktop }}vh;
    }
  }
{% endstyle %}

<section
  class="hero hero--{{ section.settings.content_position }} hero--text-{{ section.settings.text_alignment }}"
  {% if section.settings.aria_label != blank %}aria-label="{{ section.settings.aria_label | escape }}"{% endif %}
>
  <div class="hero__media">
    {%- if has_video -%}
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '1920x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            class: 'hero__video'
        }}
      {%- else -%}
        {{
          section.settings.video_url
          | external_video_url: autoplay: true, loop: true, muted: true, controls: false, playlist: section.settings.video_url.id
          | external_video_tag: class: 'hero__video hero__video--external', loading: 'lazy'
        }}
      {%- endif -%}

      {%- comment -%} Poster carries the LCP image while the video buffers. {%- endcomment -%}
      {%- if section.settings.image != blank -%}
        <div class="hero__poster" aria-hidden="true">
          {{
            section.settings.image
            | image_url: width: 1920
            | image_tag:
              class: 'hero__image',
              widths: '750, 1100, 1500, 1920, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: ''
          }}
        </div>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      {%- comment -%}
        Two <source> sets so phones never download the desktop crop.
        eager + fetchpriority:high because this is the LCP element.
      {%- endcomment -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 600 }} 600w,
              {{ section.settings.image_mobile | image_url: width: 900 }} 900w,
              {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
          <source
            media="(min-width: 750px)"
            srcset="
              {{ section.settings.image | image_url: width: 1100 }} 1100w,
              {{ section.settings.image | image_url: width: 1500 }} 1500w,
              {{ section.settings.image | image_url: width: 1920 }} 1920w,
              {{ section.settings.image | image_url: width: 2400 }} 2400w
            "
            sizes="100vw"
          >
          <img
            class="hero__image"
            src="{{ section.settings.image | image_url: width: 1500 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        </picture>
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'hero__image',
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt | default: section.settings.heading
        }}
      {%- endif -%}
    {%- else -%}
      <div class="hero__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__image placeholder-svg' }}
      </div>
    {%- endif -%}

    <span class="hero__overlay" aria-hidden="true"></span>
    {%- if section.settings.show_grain -%}
      <span class="hero__grain" aria-hidden="true"></span>
    {%- endif -%}
  </div>

  <div class="hero__content page-width">
    <div class="hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="hero__heading h0">
          {{ section.settings.heading }}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="hero__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a
              class="button button--primary button--lg"
              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            >
              {{ section.settings.button_label | escape }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a
              class="button button--ghost button--lg"
              href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}"
            >
              {{ section.settings.button_2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__trust" role="list">
          {%- for block in section.blocks -%}
            <li class="hero__trust-item" {{ block.shopify_attributes }}>
              {% render 'icon', name: block.settings.icon, size: 16 %}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <span class="hero__scroll-cue" aria-hidden="true">
      {% render 'icon', name: 'chevron-down', size: 26 %}
    </span>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "class": "section-hero",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "1920 x 1080px or wider. Also used as the video poster." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile background image", "info": "Optional portrait crop (1080 x 1350px)." },
    { "type": "video", "id": "video", "label": "Background video", "info": "Shopify-hosted video. Plays muted and looped." },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "External video URL", "info": "Used only if no Shopify-hosted video is set." },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55,
      "info": "Keep text contrast at 4.5:1 or better — it is both an accessibility and a conversion win."
    },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#0B0B0C" },
    { "type": "checkbox", "id": "show_grain", "label": "Add film grain texture", "default": true },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 85
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 80
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": true },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium fight equipment" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT FOR THE FIGHT",
      "info": "This is the page's H1 on the homepage. Work your main keyword in where it reads naturally, e.g. 'BUILT FOR THE FIGHT — PREMIUM BOXING GLOVES'."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1 (use on the homepage)" },
        { "value": "h2", "label": "H2 (use if the page already has an H1)" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Premium boxing equipment designed for fighters who refuse to compromise</p>"
    },
    { "type": "text", "id": "aria_label", "label": "Screen reader label for this section", "default": "Hero banner" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button", "default": "" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust badge",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $150" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Shipping" },
            { "value": "lock", "label": "Secure" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        { "type": "trust", "settings": { "text": "Free worldwide shipping over $150", "icon": "truck" } },
        { "type": "trust", "settings": { "text": "Handmade genuine leather", "icon": "check" } },
        { "type": "trust", "settings": { "text": "30-day returns", "icon": "lock" } }
      ]
    }
  ]
}
{% endschema %}
