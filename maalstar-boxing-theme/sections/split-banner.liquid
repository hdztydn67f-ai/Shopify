{%- comment -%}
  ------------------------------------------------------------
  SECTION: split-banner
  Half image / half copy. Used for "HANDMADE GEAR. FIGHTER APPROVED."
  ------------------------------------------------------------
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} .split-banner {
    --split-bg: {{ section.settings.background_color }};
    --split-text: {{ section.settings.text_color }};
    --split-media-width: {{ section.settings.media_width }}%;
    --split-min-height: {{ section.settings.min_height }}px;
  }
{% endstyle %}

<section class="split-banner split-banner--media-{{ section.settings.media_position }}{% if section.settings.full_width %} split-banner--full{% endif %}">
  <div class="split-banner__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          class: 'split-banner__image',
          widths: '400, 600, 800, 1100, 1400',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy',
          alt: section.settings.image.alt | default: section.settings.heading
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'split-banner__image placeholder-svg' }}
    {%- endif -%}

    {%- if section.settings.image_overlay_opacity > 0 -%}
      <span
        class="split-banner__image-overlay"
        style="opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }}"
        aria-hidden="true"
      ></span>
    {%- endif -%}
  </div>

  <div class="split-banner__content">
    <div class="split-banner__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="split-banner__heading h1">{{ section.settings.heading | escape }}</h2>
        <hr class="rule-accent">
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="split-banner__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="split-banner__features" role="list">
          {%- for block in section.blocks -%}
            <li class="split-banner__feature" {{ block.shopify_attributes }}>
              {% render 'icon', name: block.settings.icon, size: 18 %}
              <div>
                <strong>{{ block.settings.heading | escape }}</strong>
                {%- if block.settings.text != blank -%}
                  <span class="text-muted">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--primary button--lg split-banner__button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split banner",
  "class": "section-split-banner",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "1400 x 1400px or larger." },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 35,
      "max": 65,
      "step": 5,
      "unit": "%",
      "label": "Image width on desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Image darkening",
      "default": 10
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 520
    },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HANDMADE GEAR. FIGHTER APPROVED." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every glove is cut, stitched and tested by hand. Full-grain leather, multi-layer foam and a locked-in wrist wrap built to take round after round — trusted by amateurs and professionals alike.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#141417" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F5F5" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Full-grain leather" },
        { "type": "text", "id": "text", "label": "Text", "default": "Breaks in, never breaks down." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "lock", "label": "Secure" },
            { "value": "truck", "label": "Shipping" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split banner",
      "blocks": [
        { "type": "feature", "settings": { "heading": "Full-grain leather", "text": "Breaks in, never breaks down.", "icon": "check" } },
        { "type": "feature", "settings": { "heading": "Multi-layer foam", "text": "Impact absorption that lasts.", "icon": "bolt" } }
      ]
    }
  ]
}
{% endschema %}
