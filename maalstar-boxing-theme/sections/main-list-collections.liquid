{%- comment -%}
  ------------------------------------------------------------
  SECTION: main-list-collections
  The /collections index. Also the page most themes forget, which
  is a wasted internal-linking opportunity.
  ------------------------------------------------------------
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --grid-columns-desktop: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
  }
{% endstyle %}

<div class="section">
  <div class="page-width">
    <div class="section-header section-header--{{ section.settings.heading_alignment }}">
      <h1 class="section-header__heading h1">
        {{ section.settings.heading | default: page_title | escape }}
      </h1>
      <hr class="rule-accent">
      {%- if section.settings.description != blank -%}
        <div class="section-header__text text-muted">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- liquid
      if section.settings.sort_by == 'alphabetical'
        assign collection_list = collections | sort: 'title'
      else
        assign collection_list = collections
      endif
    -%}

    <ul class="collection-list product-grid" role="list">
      {%- for collection in collection_list -%}
        {%- if collection.handle != 'frontpage' -%}
          <li class="product-grid__item">
            <a class="collection-card" href="{{ collection.url }}">
              <div class="collection-card__media media media--{{ section.settings.image_ratio }}">
                {%- if collection.image -%}
                  {{
                    collection.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'collection-card__image',
                      widths: '300, 500, 800',
                      sizes: '(min-width: 990px) 25vw, 45vw',
                      loading: 'lazy'
                  }}
                {%- elsif collection.products.first.featured_media -%}
                  {{
                    collection.products.first.featured_media
                    | image_url: width: 800
                    | image_tag:
                      class: 'collection-card__image',
                      widths: '300, 500, 800',
                      sizes: '(min-width: 990px) 25vw, 45vw',
                      loading: 'lazy',
                      alt: collection.title
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'collection-card__image placeholder-svg' }}
                {%- endif -%}
                <span class="collection-card__overlay" aria-hidden="true"></span>
              </div>

              <div class="collection-card__content">
                <h2 class="collection-card__title h4">{{ collection.title }}</h2>
                {%- if section.settings.show_product_count -%}
                  <p class="collection-card__count">
                    {{ 'sections.collection.product_count' | t: count: collection.all_products_count }}
                  </p>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "class": "section-list-collections",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP BY CATEGORY" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort collections",
      "options": [
        { "value": "default", "label": "Admin order" },
        { "value": "alphabetical", "label": "Alphabetically" }
      ],
      "default": "default"
    },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": true },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "portrait"
    }
  ],
  "enabled_on": { "templates": ["list-collections"] }
}
{% endschema %}
