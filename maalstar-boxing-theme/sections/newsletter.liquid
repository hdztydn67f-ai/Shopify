{%- comment -%}
  ------------------------------------------------------------
  SECTION: newsletter
  Shopify's 'customer' form creates the customer and tags them, so
  the subscriber lands in Customers > tagged 'newsletter' and any
  email platform syncing with Shopify picks them up.
  ------------------------------------------------------------
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} .newsletter {
    --newsletter-bg: {{ section.settings.background_color }};
    --newsletter-text: {{ section.settings.text_color }};
  }
  {%- if section.settings.background_image != blank -%}
    #shopify-section-{{ section.id }} .newsletter {
      background-image:
        linear-gradient(
          rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}),
          rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }})
        ),
        url({{ section.settings.background_image | image_url: width: 1920 }});
      background-size: cover;
      background-position: center;
    }
  {%- endif -%}
{% endstyle %}

<section class="newsletter section">
  <div class="page-width">
    <div class="newsletter__inner newsletter__inner--{{ section.settings.layout }}">
      <div class="newsletter__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="newsletter__heading h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="newsletter__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="newsletter__form-wrap">
        {%- assign newsletter_form_id = 'NewsletterForm-' | append: section.id -%}
        {%- form 'customer', id: newsletter_form_id, class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">

          <div class="newsletter__field">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
              {{ 'newsletter.email_label' | t }}
            </label>
            <input
              type="email"
              id="NewsletterEmail-{{ section.id }}"
              class="field__input"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder | default: 'Enter your email' | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="NewsletterError-{{ section.id }}"
              {% endif %}
            >
            <button type="submit" class="button button--primary" name="commit">
              {{ section.settings.button_label | default: 'Subscribe' | escape }}
            </button>
          </div>

          {%- if form.errors -%}
            <p class="newsletter__message newsletter__message--error" id="NewsletterError-{{ section.id }}" role="alert">
              {% render 'icon', name: 'alert', size: 16 %}
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <p class="newsletter__message newsletter__message--success" role="status">
              {% render 'icon', name: 'check', size: 16 %}
              {{ section.settings.success_message | default: 'Thanks for subscribing. Your discount code is on its way.' }}
            </p>
          {%- endif -%}

          {%- if section.settings.disclaimer != blank -%}
            <p class="newsletter__disclaimer">{{ section.settings.disclaimer }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the roster" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "LET'S GET IN TOUCH" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up for our newsletter and receive 10% off your first order</p>"
    },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing. Your discount code is on its way."
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>No spam. Unsubscribe any time.</p>"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Stacked and centered" },
        { "value": "side-by-side", "label": "Side by side" }
      ],
      "default": "stacked"
    },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#141417" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F5F5" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Background image darkening",
      "default": 65
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
