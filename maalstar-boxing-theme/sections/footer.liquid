{%- comment -%}
  ------------------------------------------------------------
  SECTION: footer
  Multi-column: quick links, policies, contact, social, payment icons.
  ------------------------------------------------------------
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} .footer {
    --footer-bg: {{ section.settings.background_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-heading: {{ section.settings.heading_color }};
  }
{% endstyle %}

<footer class="footer" role="contentinfo">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__column footer__column--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'brand' -%}
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 400
                    | image_tag:
                      class: 'footer__logo',
                      widths: '150, 300, 400',
                      sizes: '160px',
                      loading: 'lazy',
                      alt: shop.name
                  }}
                {%- else -%}
                  <p class="footer__logo-text header__logo-text">{{ shop.name }}</p>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="footer__brand-text">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.show_social -%}
                  {% render 'social-links' %}
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'policies' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- comment -%}
                  Pulls live from Settings > Policies, so a policy edited in the
                  admin never goes stale here and no dead links get published.
                {%- endcomment -%}
                <ul class="footer__links" role="list">
                  {%- if shop.privacy_policy != blank -%}
                    <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
                  {%- endif -%}
                  {%- if shop.refund_policy != blank -%}
                    <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
                  {%- endif -%}
                  {%- if shop.shipping_policy != blank -%}
                    <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
                  {%- endif -%}
                  {%- if shop.terms_of_service != blank -%}
                    <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
                  {%- endif -%}
                  {%- if shop.subscription_policy != blank -%}
                    <li><a href="{{ shop.subscription_policy.url }}">{{ shop.subscription_policy.title }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.extra_menu != blank -%}
                    {%- for link in block.settings.extra_menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  {%- endif -%}
                </ul>

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <address class="footer__contact">
                  {%- assign street = block.settings.address | default: settings.seo_address_street -%}
                  {%- if street != blank -%}
                    <p class="footer__contact-item">
                      {% render 'icon', name: 'truck', size: 16 %}
                      <span>{{ street }}</span>
                    </p>
                  {%- endif -%}

                  {%- assign email = block.settings.email | default: settings.seo_email -%}
                  {%- if email != blank -%}
                    <p class="footer__contact-item">
                      {% render 'icon', name: 'note', size: 16 %}
                      <a href="mailto:{{ email }}">{{ email }}</a>
                    </p>
                  {%- endif -%}

                  {%- assign phone = block.settings.phone | default: settings.seo_phone -%}
                  {%- if phone != blank -%}
                    <p class="footer__contact-item">
                      {% render 'icon', name: 'bolt', size: 16 %}
                      <a href="tel:{{ phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ phone }}</a>
                    </p>
                  {%- endif -%}

                  {%- if block.settings.hours != blank -%}
                    <div class="footer__hours text-muted">{{ block.settings.hours }}</div>
                  {%- endif -%}
                </address>

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}

            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <p class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
          {{ 'general.footer.rights_reserved' | t }}
        </p>
        {%- if section.settings.show_powered_by -%}
          <p class="footer__powered">{{ powered_by_link }}</p>
        {%- endif -%}
      </div>

      <div class="footer__bottom-right">
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'general.footer.payment_methods' | t }}</span>
            <ul class="footer__payment-list" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#08080A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#B9B9BD" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#F5F5F5" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_powered_by", "label": "Show 'Powered by Shopify'", "default": false }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Premium boxing equipment, handmade for fighters who refuse to compromise.</p>"
        },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "policies",
      "name": "Policies",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Company" },
        {
          "type": "link_list",
          "id": "extra_menu",
          "label": "Additional links",
          "info": "Store policies are pulled automatically from Settings > Policies."
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
        { "type": "text", "id": "address", "label": "Address", "info": "Falls back to Theme settings > SEO." },
        { "type": "text", "id": "email", "label": "Email" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "richtext", "id": "hours", "label": "Opening hours", "default": "<p>Mon–Fri, 9am–6pm</p>" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
