{%- comment -%}
  ------------------------------------------------------------
  SECTION: main-contact
  Contact form plus store details. The header menu links here, so
  this needs to exist as page.contact.
  ------------------------------------------------------------
{%- endcomment -%}
<div class="section">
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs' %}
    {%- endif -%}

    <div class="contact">
      <div class="contact__intro">
        <h1 class="h1">{{ page.title | default: section.settings.heading }}</h1>
        <hr class="rule-accent">

        {%- if page.content != blank -%}
          <div class="rte">{{ page.content }}</div>
        {%- elsif section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <ul class="contact__details" role="list">
          {%- assign contact_email = section.settings.email | default: settings.seo_email -%}
          {%- if contact_email != blank -%}
            <li>
              {% render 'icon', name: 'note', size: 18 %}
              <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
            </li>
          {%- endif -%}

          {%- assign contact_phone = section.settings.phone | default: settings.seo_phone -%}
          {%- if contact_phone != blank -%}
            <li>
              {% render 'icon', name: 'bolt', size: 18 %}
              <a href="tel:{{ contact_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ contact_phone }}</a>
            </li>
          {%- endif -%}

          {%- assign contact_address = section.settings.address | default: settings.seo_address_street -%}
          {%- if contact_address != blank -%}
            <li>
              {% render 'icon', name: 'truck', size: 18 %}
              <span>{{ contact_address }}</span>
            </li>
          {%- endif -%}

          {%- if section.settings.hours != blank -%}
            <li>
              {% render 'icon', name: 'check', size: 18 %}
              <span>{{ section.settings.hours }}</span>
            </li>
          {%- endif -%}
        </ul>

        {% render 'social-links' %}
      </div>

      <div class="contact__form-wrap">
        {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="newsletter__message newsletter__message--success" role="status">
              {% render 'icon', name: 'check', size: 16 %}
              {{ 'contact.success' | t }}
            </p>
          {%- elsif form.errors -%}
            <p class="newsletter__message newsletter__message--error" role="alert">
              {% render 'icon', name: 'alert', size: 16 %}
              {{ 'contact.error' | t }}
            </p>
          {%- endif -%}

          <div class="contact__row">
            <div class="field">
              <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
              <input type="text" id="ContactName" class="field__input" name="contact[name]" value="{{ form.name }}" autocomplete="name">
            </div>
            <div class="field">
              <label class="field__label" for="ContactEmail">{{ 'contact.email' | t }}</label>
              <input type="email" id="ContactEmail" class="field__input" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" required>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
            <input type="tel" id="ContactPhone" class="field__input" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>

          {%- if section.settings.show_order_number -%}
            <div class="field">
              <label class="field__label" for="ContactOrder">{{ 'contact.order_number' | t }}</label>
              <input type="text" id="ContactOrder" class="field__input" name="contact[Order number]">
            </div>
          {%- endif -%}

          <div class="field">
            <label class="field__label" for="ContactMessage">{{ 'contact.message' | t }}</label>
            <textarea id="ContactMessage" class="field__input field__input--textarea" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="button button--primary button--full button--lg">{{ 'contact.send' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "class": "section-main-contact",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "GET IN TOUCH" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Fallback text",
      "info": "Used only if the page itself has no content.",
      "default": "<p>Questions about sizing, custom orders or bulk gym orders? Send us a message and we will get back to you within one business day.</p>"
    },
    { "type": "checkbox", "id": "show_order_number", "label": "Show order number field", "default": true },
    { "type": "header", "content": "Store details" },
    { "type": "text", "id": "email", "label": "Email", "info": "Falls back to Theme settings > SEO." },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "address", "label": "Address" },
    { "type": "text", "id": "hours", "label": "Opening hours", "default": "Mon–Fri, 9am–6pm" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
