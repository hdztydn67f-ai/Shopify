<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background | default: '#0B0B0C' }}">

    {%- comment -%} ---------- PERFORMANCE: EARLY HINTS ---------- {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- comment -%} ---------- SEO: TITLE + DESCRIPTION ---------- {%- endcomment -%}
    <title>
      {%- if request.page_type == 'index' -%}
        {{ shop.name }}{% if settings.seo_home_tagline != blank %} | {{ settings.seo_home_tagline }}{% endif %}
      {%- else -%}
        {{ page_title }}
        {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- liquid
      assign meta_description = page_description
      if meta_description == blank and request.page_type == 'index'
        assign meta_description = settings.seo_home_description
      endif
      if meta_description == blank and request.page_type == 'product'
        assign meta_description = product.description | strip_html | truncatewords: 30
      endif
      if meta_description == blank and request.page_type == 'collection'
        assign meta_description = collection.description | strip_html | truncatewords: 30
      endif
      if meta_description == blank
        assign meta_description = shop.description
      endif
    -%}
    {%- if meta_description != blank -%}
      <meta name="description" content="{{ meta_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      Pagination hints help Google understand deep collection pages.
      hreflang tags for Markets/languages are emitted automatically inside content_for_header,
      so we deliberately do NOT duplicate them here.
    {%- endcomment -%}
    {%- if paginate.previous -%}
      <link rel="prev" href="{{ paginate.previous.url }}">
    {%- endif -%}
    {%- if paginate.next -%}
      <link rel="next" href="{{ paginate.next.url }}">
    {%- endif -%}
    {%- if request.page_type == 'search' or request.page_type == 'customers/login' or request.page_type == 'customers/register' or request.page_type == 'cart' -%}
      <meta name="robots" content="noindex, follow">
    {%- else -%}
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    {%- endif -%}

    {%- comment -%} ---------- SEO: OPEN GRAPH / TWITTER ---------- {%- endcomment -%}
    {%- liquid
      assign og_title = page_title
      assign og_type = 'website'
      assign og_image = settings.social_share_image

      case request.page_type
        when 'product'
          assign og_type = 'product'
          if product.featured_media
            assign og_image = product.featured_media.preview_image
          endif
        when 'article'
          assign og_type = 'article'
          if article.image
            assign og_image = article.image
          endif
        when 'collection'
          if collection.image
            assign og_image = collection.image
          endif
        when 'index'
          assign og_title = shop.name
      endcase
    -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ og_title | escape }}">
    <meta property="og:type" content="{{ og_type }}">
    <meta property="og:locale" content="{{ request.locale.iso_code }}">
    {%- if meta_description != blank -%}
      <meta property="og:description" content="{{ meta_description | escape }}">
    {%- endif -%}
    {%- if og_image -%}
      <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
      <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
    {%- endif -%}
    {%- if request.page_type == 'product' -%}
      <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
      <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
      <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | escape }}">
    {%- if meta_description != blank -%}
      <meta name="twitter:description" content="{{ meta_description | escape }}">
    {%- endif -%}
    {%- if og_image -%}
      <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
    {%- endif -%}
    {%- if settings.seo_twitter_handle != blank -%}
      <meta name="twitter:site" content="@{{ settings.seo_twitter_handle | remove: '@' }}">
    {%- endif -%}

    {%- comment -%} ---------- SEO: STRUCTURED DATA (JSON-LD) ---------- {%- endcomment -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | append: routes.root_url | json }},
        {% if settings.logo %}"logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},{% endif %}
        {% if settings.seo_address_street != blank %}
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ settings.seo_address_street | json }},
            "addressLocality": {{ settings.seo_address_city | json }},
            "addressRegion": {{ settings.seo_address_region | json }},
            "postalCode": {{ settings.seo_address_zip | json }},
            "addressCountry": {{ settings.seo_address_country | json }}
          },
        {% endif %}
        {% if settings.seo_phone != blank %}
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": {{ settings.seo_phone | json }},
            "contactType": "customer service",
            "email": {{ settings.seo_email | json }},
            "availableLanguage": {{ request.locale.name | json }}
          },
        {% endif %}
        "sameAs": [
          {%- assign socials = '' -%}
          {%- if settings.social_instagram_link != blank -%}{%- assign socials = socials | append: settings.social_instagram_link | append: '|' -%}{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}{%- assign socials = socials | append: settings.social_facebook_link | append: '|' -%}{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}{%- assign socials = socials | append: settings.social_youtube_link | append: '|' -%}{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}{%- assign socials = socials | append: settings.social_tiktok_link | append: '|' -%}{%- endif -%}
          {%- if settings.social_x_link != blank -%}{%- assign socials = socials | append: settings.social_x_link -%}{%- endif -%}
          {%- assign social_list = socials | split: '|' -%}
          {%- for s in social_list -%}
            {%- if s != blank -%}{{ s | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | append: routes.root_url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": {{ shop.url | append: routes.search_url | append: "?q={search_term_string}" | json }}
          },
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    {%- if request.page_type == 'product' -%}
      {%- assign product_seo_image = product.featured_media.preview_image -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "name": {{ product.title | json }},
          "url": {{ shop.url | append: product.url | json }},
          "sku": {{ product.selected_or_first_available_variant.sku | json }},
          "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
          {% if product_seo_image %}"image": [{{ product_seo_image | image_url: width: 1200 | prepend: "https:" | json }}],{% endif %}
          "description": {{ product.description | strip_html | truncatewords: 60 | json }},
          "offers": [
            {%- for variant in product.variants -%}
              {
                "@type": "Offer",
                "sku": {{ variant.sku | json }},
                "url": {{ shop.url | append: variant.url | json }},
                "price": {{ variant.price | divided_by: 100.0 | json }},
                "priceCurrency": {{ cart.currency.iso_code | json }},
                "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
                "itemCondition": "https://schema.org/NewCondition"
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}

    {%- if request.page_type == 'article' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "headline": {{ article.title | json }},
          "articleBody": {{ article.content | strip_html | json }},
          "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
          "author": { "@type": "Person", "name": {{ article.author | json }} },
          "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
          "mainEntityOfPage": { "@type": "WebPage", "@id": {{ shop.url | append: article.url | json }} }
          {%- if article.image -%},"image": [{{ article.image | image_url: width: 1200 | prepend: "https:" | json }}]{%- endif -%}
        }
      </script>
    {%- endif -%}

    {%- comment -%} Breadcrumbs win extra SERP real estate on collection + product pages. {%- endcomment -%}
    {%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' or request.page_type == 'article' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: routes.root_url | json }} }
            {%- if request.page_type == 'product' -%}
              {%- if collection.title -%}
                ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
                ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
              {%- else -%}
                ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
              {%- endif -%}
            {%- elsif request.page_type == 'collection' -%}
              ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
            {%- elsif request.page_type == 'page' -%}
              ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
            {%- elsif request.page_type == 'article' -%}
              ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} }
              ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ shop.url | append: article.url | json }} }
            {%- endif -%}
          ]
        }
      </script>
    {%- endif -%}

    {%- comment -%} ---------- TYPOGRAPHY ---------- {%- endcomment -%}
    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_heading_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = body_font | font_modify: 'style', 'italic'
      assign heading_font_bolder = heading_font | font_modify: 'weight', 'bolder'
    -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ heading_font_bolder | font_face: font_display: 'swap' }}

    {%- comment -%} ---------- GLOBAL DESIGN TOKENS ---------- {%- endcomment -%}
    {% style %}
      :root {
        /* ---- Brand palette (fight-club contrast) ---- */
        --color-bg: {{ settings.color_background }};
        --color-bg-rgb: {{ settings.color_background.red }}, {{ settings.color_background.green }}, {{ settings.color_background.blue }};
        --color-surface: {{ settings.color_surface }};
        --color-surface-2: {{ settings.color_surface | color_lighten: 4 }};
        --color-border: {{ settings.color_text | color_modify: 'alpha', 0.14 }};
        --color-border-strong: {{ settings.color_text | color_modify: 'alpha', 0.28 }};

        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --color-text-muted: {{ settings.color_text | color_modify: 'alpha', 0.62 }};
        --color-text-faint: {{ settings.color_text | color_modify: 'alpha', 0.38 }};

        --color-accent: {{ settings.color_accent }};
        --color-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
        --color-accent-hover: {{ settings.color_accent | color_lighten: 8 }};
        --color-accent-text: {{ settings.color_accent_text }};

        --color-blood: {{ settings.color_alert }};
        --color-blood-rgb: {{ settings.color_alert.red }}, {{ settings.color_alert.green }}, {{ settings.color_alert.blue }};
        --color-success: #1E9E5A;
        --color-sale: {{ settings.color_sale }};

        --color-btn-primary-bg: {{ settings.color_accent }};
        --color-btn-primary-text: {{ settings.color_accent_text }};

        /* ---- Type ---- */
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-style: {{ body_font.style }};
        --font-body-weight: {{ body_font.weight }};
        --font-body-weight-bold: {{ body_font.weight | plus: 300 | at_most: 1000 }};

        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-style: {{ heading_font.style }};
        --font-heading-weight: {{ heading_font.weight }};

        --font-heading-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
        --font-heading-tracking: {{ settings.heading_letter_spacing }}em;
        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

        /* Fluid type scale — clamps keep headings brutal on desktop, readable on mobile */
        --text-xs: clamp(0.68rem, 0.66rem + 0.1vw, 0.75rem);
        --text-sm: clamp(0.78rem, 0.75rem + 0.15vw, 0.875rem);
        --text-base: clamp(0.9rem, 0.87rem + 0.2vw, 1rem);
        --text-lg: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
        --text-xl: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
        --text-2xl: clamp(1.6rem, 1.3rem + 1.4vw, 2.4rem);
        --text-3xl: clamp(2rem, 1.5rem + 2.6vw, 3.6rem);
        --text-4xl: clamp(2.6rem, 1.6rem + 4.6vw, 6rem);

        /* ---- Spacing / rhythm (8px base) ---- */
        --space-3xs: 0.25rem;
        --space-2xs: 0.5rem;
        --space-xs: 0.75rem;
        --space-sm: 1rem;
        --space-md: 1.5rem;
        --space-lg: 2rem;
        --space-xl: 3rem;
        --space-2xl: 4.5rem;
        --space-3xl: 6.5rem;
        --section-padding-y: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);

        /* ---- Layout ---- */
        --page-width: {{ settings.page_width }}px;
        --page-gutter: clamp(1rem, 0.5rem + 2vw, 2.5rem);
        --grid-gap: clamp(0.75rem, 0.4rem + 1.2vw, 1.5rem);

        /* ---- Shape + depth ---- */
        --radius-none: 0px;
        --radius-sm: {{ settings.corner_radius | at_most: 4 }}px;
        --radius-md: {{ settings.corner_radius }}px;
        --radius-lg: {{ settings.corner_radius | times: 2 }}px;
        --radius-pill: 999px;
        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
        --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.45);
        --shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.6);
        --shadow-accent: 0 8px 30px rgba(var(--color-accent-rgb), 0.28);

        /* ---- Motion ---- */
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
        --dur-fast: 150ms;
        --dur-base: 250ms;
        --dur-slow: 420ms;

        /* ---- Chrome ---- */
        --header-height: 72px;
        --topbar-height: 38px;
        --drawer-width: 420px;
        --z-header: 100;
        --z-overlay: 200;
        --z-drawer: 210;
        --z-modal: 300;
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      body {
        margin: 0;
        min-height: 100vh;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
        font-size: calc(var(--text-base) * var(--font-body-scale));
        line-height: 1.6;
        letter-spacing: 0.01em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }

      h1, h2, h3, h4, h5, h6, .h0, .h1, .h2, .h3 {
        font-family: var(--font-heading-family);
        font-style: var(--font-heading-style);
        font-weight: var(--font-heading-weight);
        text-transform: var(--font-heading-transform);
        letter-spacing: var(--font-heading-tracking);
        line-height: 1.02;
        margin: 0 0 var(--space-sm);
      }

      img, svg, video { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration: none; }

      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }

      .skip-to-content:not(:focus) {
        position: absolute !important;
        width: 1px; height: 1px;
        overflow: hidden; clip: rect(0 0 0 0);
        clip-path: inset(50%); white-space: nowrap;
      }
      .visually-hidden {
        position: absolute !important;
        width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0);
        clip-path: inset(50%); border: 0; white-space: nowrap;
      }
    {% endstyle %}

    <link rel="preload" as="style" href="{{ 'base.css' | asset_url }}">
    {{ 'base.css' | stylesheet_tag }}
    {{ 'components.css' | stylesheet_tag }}

    {%- comment -%} Flip .no-js -> .js and pre-apply modal state before first paint (kills the flash). {%- endcomment -%}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.MSB = window.MSB || {};
      window.MSB.routes = {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      };
      window.MSB.strings = {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        added: {{ 'products.product.added' | t | json }},
        error: {{ 'general.errors.generic' | t | json }},
        cartTitle: {{ 'sections.cart.title' | t | json }},
        cartEmpty: {{ 'sections.cart.empty' | t | json }},
        continueShopping: {{ 'general.continue_shopping' | t | json }},
        remove: {{ 'sections.cart.remove' | t | json }},
        noteSaved: {{ 'sections.cart.note_saved' | t | json }},
        calculating: {{ 'sections.cart.calculating' | t | json }},
        ratesFound: {{ 'sections.cart.rates_found' | t | json }},
        noShippingRates: {{ 'sections.cart.no_shipping_rates' | t | json }},
        applyingDiscount: {{ 'sections.cart.applying_discount' | t | json }},
        discountApplied: {{ 'sections.cart.discount_applied' | t | json }},
        discountAtCheckout: {{ 'sections.cart.discount_at_checkout' | t | json }},
        discountError: {{ 'sections.cart.discount_error' | t | json }},
        freeShippingRemaining: {{ 'sections.cart.free_shipping_remaining_js' | t | json }},
        freeShippingUnlocked: {{ 'sections.cart.free_shipping_unlocked' | t | json }},
        wishlistAdded: {{ 'general.wishlist.added' | t | json }},
        wishlistRemoved: {{ 'general.wishlist.removed' | t | json }}
      };
      window.MSB.settings = {
        moneyFormat: {{ shop.money_format | json }},
        cartType: 'drawer',
        ageGateEnabled: {{ settings.age_gate_enabled | json }},
        ageGateDays: {{ settings.age_gate_remember_days | json }},
        cookieBannerEnabled: {{ settings.cookie_banner_enabled | json }},
        freeShippingThreshold: {{ settings.cart_free_shipping_threshold | json }}
      };
      try {
        if (localStorage.getItem('msb:age-verified') === 'true') {
          document.documentElement.classList.add('age-verified');
        }
        if (localStorage.getItem('msb:cookies-ack') === 'true') {
          document.documentElement.classList.add('cookies-ack');
        }
      } catch (e) {}
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}{% if settings.heading_uppercase %} uppercase-headings{% endif %}">
    <a class="skip-to-content button button--primary" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- comment -%} SVG sprite: every icon in the theme lives here, so icons cost 0 extra requests. {%- endcomment -%}
    {% render 'icon-sprite' %}

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} ==================== AJAX CART DRAWER ==================== {%- endcomment -%}
    <div
      class="drawer-overlay"
      id="DrawerOverlay"
      data-overlay
      aria-hidden="true"
    ></div>

    <cart-drawer
      id="CartDrawer"
      class="cart-drawer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="CartDrawerTitle"
      aria-hidden="true"
      tabindex="-1"
      data-cart-drawer
    >
      <header class="cart-drawer__header">
        <h2 class="cart-drawer__title h3" id="CartDrawerTitle">
          {{ 'sections.cart.title' | t }}
          <span class="cart-drawer__count" data-cart-count>{{ cart.item_count }}</span>
        </h2>
        <button
          type="button"
          class="cart-drawer__close icon-button"
          data-drawer-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon', name: 'close' %}
        </button>
      </header>

      {%- if settings.cart_free_shipping_threshold > 0 -%}
        <div class="cart-drawer__shipping-bar" data-free-shipping-bar>
          {% render 'free-shipping-bar', cart: cart %}
        </div>
      {%- endif -%}

      <div class="cart-drawer__body" data-cart-body>
        <form
          action="{{ routes.cart_url }}"
          method="post"
          id="CartDrawerForm"
          class="cart-drawer__form"
          novalidate
          data-cart-form
        >
          <div class="cart-drawer__items" data-cart-items>
            {%- if cart.item_count > 0 -%}
              {%- for item in cart.items -%}
                {% render 'cart-drawer-item', item: item, forloop: forloop %}
              {%- endfor -%}
            {%- else -%}
              <div class="cart-drawer__empty" data-cart-empty>
                <span class="cart-drawer__empty-icon">{% render 'icon', name: 'cart', size: 48 %}</span>
                <p class="cart-drawer__empty-text">{{ 'sections.cart.empty' | t }}</p>
                <a class="button button--primary" href="{{ routes.all_products_collection_url }}" data-drawer-close>
                  {{ 'general.continue_shopping' | t }}
                </a>
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} ---- Cart tools: note / shipping estimator / discount ---- {%- endcomment -%}
          <div class="cart-drawer__tools" data-cart-tools {% if cart.item_count == 0 %}hidden{% endif %}>
            {%- if settings.cart_show_note -%}
              <details class="cart-tool" data-cart-tool="note">
                <summary class="cart-tool__summary">
                  {% render 'icon', name: 'note' %}
                  <span>{{ 'sections.cart.note_toggle' | t }}</span>
                  {% render 'icon', name: 'chevron-down', class: 'cart-tool__chevron' %}
                </summary>
                <div class="cart-tool__panel">
                  <label class="visually-hidden" for="CartNote">{{ 'sections.cart.note' | t }}</label>
                  <textarea
                    id="CartNote"
                    name="note"
                    class="field__input field__input--textarea"
                    rows="3"
                    placeholder="{{ 'sections.cart.note_placeholder' | t }}"
                    data-cart-note
                  >{{ cart.note }}</textarea>
                  <p class="cart-tool__status" data-note-status aria-live="polite"></p>
                </div>
              </details>
            {%- endif -%}

            {%- if settings.cart_show_shipping_estimator -%}
              <details class="cart-tool" data-cart-tool="shipping">
                <summary class="cart-tool__summary">
                  {% render 'icon', name: 'truck' %}
                  <span>{{ 'sections.cart.shipping_estimate' | t }}</span>
                  {% render 'icon', name: 'chevron-down', class: 'cart-tool__chevron' %}
                </summary>
                <div class="cart-tool__panel" data-shipping-calculator>
                  <div class="field">
                    <label class="field__label" for="ShippingCountry">{{ 'sections.cart.country' | t }}</label>
                    <select id="ShippingCountry" class="field__input field__input--select" data-shipping-country>
                      {%- for country in country_option_tags -%}{{ country }}{%- endfor -%}
                    </select>
                  </div>
                  <div class="field" data-shipping-province-wrapper hidden>
                    <label class="field__label" for="ShippingProvince">{{ 'sections.cart.province' | t }}</label>
                    <select id="ShippingProvince" class="field__input field__input--select" data-shipping-province></select>
                  </div>
                  <div class="field">
                    <label class="field__label" for="ShippingZip">{{ 'sections.cart.zip' | t }}</label>
                    <input type="text" id="ShippingZip" class="field__input" autocomplete="postal-code" data-shipping-zip>
                  </div>
                  <button type="button" class="button button--secondary button--full" data-shipping-submit>
                    {{ 'sections.cart.calculate_shipping' | t }}
                  </button>
                  <div class="cart-tool__results" data-shipping-results aria-live="polite"></div>
                </div>
              </details>
            {%- endif -%}

            {%- if settings.cart_show_discount -%}
              <details class="cart-tool" data-cart-tool="discount">
                <summary class="cart-tool__summary">
                  {% render 'icon', name: 'tag' %}
                  <span>{{ 'sections.cart.discount_toggle' | t }}</span>
                  {% render 'icon', name: 'chevron-down', class: 'cart-tool__chevron' %}
                </summary>
                <div class="cart-tool__panel">
                  <div class="cart-tool__inline">
                    <label class="visually-hidden" for="CartDiscount">{{ 'sections.cart.discount' | t }}</label>
                    <input
                      type="text"
                      id="CartDiscount"
                      class="field__input"
                      placeholder="{{ 'sections.cart.discount_placeholder' | t }}"
                      autocomplete="off"
                      autocapitalize="characters"
                      data-discount-input
                    >
                    <button type="button" class="button button--secondary" data-discount-apply>
                      {{ 'sections.cart.apply' | t }}
                    </button>
                  </div>
                  <p class="cart-tool__status" data-discount-status aria-live="polite"></p>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="cart-tool__applied" data-discount-applied>
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li>
                          {% render 'icon', name: 'tag' %}
                          {{ discount.title }} (&minus;{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}
          </div>

          <footer class="cart-drawer__footer" data-cart-footer {% if cart.item_count == 0 %}hidden{% endif %}>
            <div class="cart-drawer__subtotal">
              <span class="cart-drawer__subtotal-label">{{ 'sections.cart.subtotal' | t }}</span>
              <span class="cart-drawer__subtotal-value" data-cart-subtotal>{{ cart.total_price | money_with_currency }}</span>
            </div>
            <p class="cart-drawer__tax">{{ 'sections.cart.taxes_and_shipping' | t }}</p>

            <button
              type="submit"
              name="checkout"
              class="button button--primary button--full button--checkout"
              form="CartDrawerForm"
              {% if cart.item_count == 0 %}disabled{% endif %}
            >
              {% render 'icon', name: 'lock' %}
              {{ 'sections.cart.checkout' | t }}
            </button>

            <a class="cart-drawer__view-cart" href="{{ routes.cart_url }}">{{ 'sections.cart.view_cart' | t }}</a>

            {%- if settings.cart_show_payment_icons and additional_checkout_buttons -%}
              <div class="cart-drawer__dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
          </footer>
        </form>
      </div>

      <div class="cart-drawer__loader" data-cart-loader hidden>
        <span class="spinner" aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'general.loading' | t }}</span>
      </div>
    </cart-drawer>

    {%- comment -%} ==================== AGE VERIFICATION ==================== {%- endcomment -%}
    {%- if settings.age_gate_enabled -%}
      <div
        class="age-gate"
        id="AgeGate"
        role="dialog"
        aria-modal="true"
        aria-labelledby="AgeGateTitle"
        aria-describedby="AgeGateBody"
        data-age-gate
      >
        <div class="age-gate__backdrop"></div>
        <div class="age-gate__panel" data-age-gate-panel>
          {%- if settings.age_gate_image != blank -%}
            <div class="age-gate__media">
              {{
                settings.age_gate_image
                | image_url: width: 480
                | image_tag: loading: 'eager', fetchpriority: 'high', alt: shop.name, class: 'age-gate__logo'
              }}
            </div>
          {%- elsif settings.logo != blank -%}
            <div class="age-gate__media">
              {{ settings.logo | image_url: width: 320 | image_tag: loading: 'eager', alt: shop.name, class: 'age-gate__logo' }}
            </div>
          {%- endif -%}

          <h2 class="age-gate__title h2" id="AgeGateTitle">{{ settings.age_gate_heading }}</h2>
          <p class="age-gate__body" id="AgeGateBody">{{ settings.age_gate_text }}</p>

          <div class="age-gate__actions">
            <button type="button" class="button button--primary" data-age-gate-accept>
              {{ settings.age_gate_yes_label }}
            </button>
            <button type="button" class="button button--ghost" data-age-gate-decline>
              {{ settings.age_gate_no_label }}
            </button>
          </div>

          <p class="age-gate__declined" data-age-gate-declined hidden>
            {{ settings.age_gate_decline_message }}
          </p>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ==================== QUICK VIEW MODAL ==================== {%- endcomment -%}
    <div
      class="quick-view-modal"
      id="QuickViewModal"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'products.product.quick_view' | t }}"
      aria-hidden="true"
      data-quick-view-modal
    >
      <div class="quick-view-modal__backdrop" data-quick-view-close></div>
      <div class="quick-view-modal__panel" tabindex="-1" data-quick-view-panel>
        <button
          type="button"
          class="icon-button quick-view-modal__close"
          data-quick-view-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon', name: 'close' %}
        </button>
        <div class="quick-view-modal__target" data-quick-view-target>
          <div class="quick-view-modal__loading">
            <span class="spinner" aria-hidden="true"></span>
            <span class="visually-hidden">{{ 'general.loading' | t }}</span>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} ==================== COOKIE CONSENT ==================== {%- endcomment -%}
    {%- if settings.cookie_banner_enabled -%}
      <div
        class="cookie-banner"
        id="CookieBanner"
        role="region"
        aria-label="{{ 'general.cookies.label' | t }}"
        data-cookie-banner
      >
        <div class="cookie-banner__inner page-width">
          <div class="cookie-banner__content">
            {% render 'icon', name: 'cookie', class: 'cookie-banner__icon' %}
            <p class="cookie-banner__text">
              {{ settings.cookie_banner_text }}
              {%- if settings.cookie_policy_page != blank -%}
                <a class="cookie-banner__link" href="{{ settings.cookie_policy_page }}">
                  {{ 'general.cookies.learn_more' | t }}
                </a>
              {%- endif -%}
            </p>
          </div>
          <div class="cookie-banner__actions">
            <button type="button" class="button button--ghost button--sm" data-cookie-decline>
              {{ settings.cookie_decline_label }}
            </button>
            <button type="button" class="button button--primary button--sm" data-cookie-accept>
              {{ settings.cookie_accept_label }}
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Live region used by the Ajax cart + quick add for screen readers. {%- endcomment -%}
    <div class="visually-hidden" aria-live="polite" role="status" data-cart-live-region></div>

    {%- comment -%} Toast host for "Added to cart" / error feedback. {%- endcomment -%}
    <div class="toast-stack" id="ToastStack" aria-live="polite" aria-atomic="true"></div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
